@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oegen: <https://example.org/openevidence/generated/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/openevidence/questions/q_hypothyroidism_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is levothyroxine compared with other agents for Hypothyroidism?"^^xsd:string ;
    oe:answerText "Levothyroxine (LT4) is effective for most patients with hypothyroidism. However, a minority of the patients remain symptomatic despite the normalization of serum thyrotropin levels."^^xsd:string ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_hypothyroidism_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_hypothyroidism_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_hypothyroidism_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_hypothyroidism_efficacy-con> .

<https://example.org/openevidence/drugs/levothyroxine> oe:treats <https://example.org/openevidence/diseases/hypothyroidism> .
<https://example.org/openevidence/generated/ev_q_hypothyroidism_efficacy_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_hypothyroidism_efficacy_0-tt> ;
    holon:confidence "0.26"^^xsd:decimal ;
    holon:evidenceLevel "Level-5" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/37738506> ;
    holon:inHolon <https://example.org/openevidence/questions/q_hypothyroidism_efficacy> ;
    oe:effectiveness "inconclusive" .
<https://example.org/openevidence/generated/ev_q_hypothyroidism_efficacy_0-tt> rdf:subject <https://example.org/openevidence/drugs/levothyroxine> ;
    rdf:predicate oe:treats ;
    rdf:object <https://example.org/openevidence/diseases/hypothyroidism> .

<https://example.org/openevidence/drugs/atorvastatin> oe:treats <https://example.org/openevidence/diseases/coronary_artery_disease> .   # ungrounded (naive)
<https://example.org/openevidence/drugs/morphine> oe:treats <https://example.org/openevidence/diseases/pancreatitis> .   # ungrounded (naive)
<https://example.org/openevidence/drugs/prednisone> oe:treats <https://example.org/openevidence/diseases/addison_disease> .   # ungrounded (naive)
