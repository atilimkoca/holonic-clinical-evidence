@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom2027 a oe:Symptom ;
    rdfs:label "Symptom-2027"@en .

oeevt:entry2027 a holon:EntityEntry ;
    holon:entity oed:disease2027 ;
    holon:entryMode "topic-match" .

oeevt:ev2027_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2027_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.30 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:q2027 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src2027 ;
    oe:effectiveness "effective" .

oeevt:ev2027_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2027_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.72 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:q2027 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src2027 ;
    oe:effectiveness "effective" .

oeevt:ev2027_0-tt rdf:object oed:disease2027 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2027 .

oeevt:ev2027_1-tt rdf:object oed:disease2027 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2027 .

oedrug:drug2027 a oe:Drug ;
    rdfs:label "Drug-2027"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease2027 .

oeq:q2027 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 2027"@en ;
    holon:evidenceQualityThreshold 0.50 ;
    holon:hasBoundaryGraph oeq:q2027-bnd ;
    holon:hasContextGraph oeq:q2027-ctx ;
    holon:hasInteriorGraph oeq:q2027-int ;
    holon:hasProjectionGraph oeq:q2027-prj ;
    holon:narrativeFunction "Establishes Drug-2027 as first-line for Disease-2027"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-2027 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Cardiology" ;
    oe:questionText "What is the first-line treatment for Disease-2027?"^^xsd:string .

oesrc:src2027 a oe:SystematicReview ;
    rdfs:label "Source-2027"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30002027"^^xsd:string .

oed:disease2027 a oe:Disease ;
    rdfs:label "Disease-2027"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

