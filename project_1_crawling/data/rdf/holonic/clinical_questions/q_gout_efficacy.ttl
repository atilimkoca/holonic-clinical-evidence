oeq:q_gout_efficacy a holon:ClinicalQuestionHolon ;
    rdfs:label "How effective is allopurinol compared with other agents for Gout?"@en ;
    prov:generatedAtTime "2025-10-01T10:00:00+00:00"^^xsd:dateTime ;
