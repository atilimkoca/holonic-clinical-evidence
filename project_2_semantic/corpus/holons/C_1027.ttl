@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom1027 a oe:Symptom ;
    rdfs:label "Symptom-1027"@en .

oeevt:entry1027 a holon:EntityEntry ;
    holon:entity oed:disease1027 ;
    holon:entryMode "topic-match" .

oeevt:ev1027_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1027_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.71 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:chain1027 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1027 ;
    oe:effectiveness "effective" .

oeevt:ev1027_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1027_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.93 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:chain1027 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1027 ;
    oe:effectiveness "effective" .

oeevt:ev1027_0-tt rdf:object oed:disease1027 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1027 .

oeevt:ev1027_1-tt rdf:object oed:disease1027 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1027 .

oedrug:drug1027 a oe:Drug ;
    rdfs:label "Drug-1027"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease1027 .

oeq:chain1027 a holon:EvidenceChainHolon ;
    rdfs:label "Holon 1027"@en ;
    holon:aggregateConfidence 0.82 ;
    holon:evidenceQualityThreshold 0.50 ;
    holon:hasBoundaryGraph oeq:chain1027-bnd ;
    holon:hasContextGraph oeq:chain1027-ctx ;
    holon:hasInteriorGraph oeq:chain1027-int ;
    holon:hasProjectionGraph oeq:chain1027-prj ;
    holon:narrativeFunction "Establishes Drug-1027 as first-line for Disease-1027"@en ;
    holon:summaryConfidence 0.85 .

oesrc:src1027 a oe:SystematicReview ;
    rdfs:label "Source-1027"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30001027"^^xsd:string .

oed:disease1027 a oe:Disease ;
    rdfs:label "Disease-1027"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

