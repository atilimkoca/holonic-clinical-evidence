oeevt:entry_q_heart_failure_efficacy a holon:EntityEntry ;
    holon:entity oed:heart_failure ;
    holon:entryMode "topic-match" .

oeevt:ev_q_heart_failure_efficacy a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev_q_heart_failure_efficacy-tt ;
    holon:assessedBy oeq:openevidence_ai ;
