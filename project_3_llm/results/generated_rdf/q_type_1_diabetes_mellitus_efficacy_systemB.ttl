    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_type_1_diabetes_mellitus_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_type_1_diabetes_mellitus_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_type_1_diabetes_mellitus_efficacy-con> .

<https://example.org/openevidence/drugs/insulin_glargine> oe:treats <https://example.org/openevidence/diseases/type_1_diabetes_mellitus> .
