@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom2032 a oe:Symptom ;
    rdfs:label "Symptom-2032"@en .

oeevt:ev2032_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2032_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.30 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:q2032 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src2032 ;
    oe:effectiveness "effective" .

oeevt:ev2032_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2032_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.87 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q2032 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src2032 ;
    oe:effectiveness "effective" .

oeevt:ev2032_0-tt rdf:object oed:disease2032 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2032 .

oeevt:ev2032_1-tt rdf:object oed:disease2032 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2032 .

oedrug:drug2032 a oe:Drug ;
    rdfs:label "Drug-2032"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease2032 .

oeq:q2032 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 2032"@en ;
    holon:narrativeFunction "Establishes Drug-2032 as first-line for Disease-2032"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-2032 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Psychiatry" ;
    oe:questionText "What is the first-line treatment for Disease-2032?"^^xsd:string .

oesrc:src2032 a oe:SystematicReview ;
    rdfs:label "Source-2032"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30002032"^^xsd:string .

oed:disease2032 a oe:Disease ;
    rdfs:label "Disease-2032"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

