<https://example.org/openevidence/questions/q_atrial_fibrillation_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is apixaban compared with other agents for Atrial Fibrillation?"^^xsd:string ;
    oe:answerText "The optimal timing of oral anticoagulation for prevention of early ischaemic stroke recurrence in people with acute ischaemic stroke and atrial fibrillation remains uncertain. We aimed to estimate the effects of starting a direct oral anticoagulant (DOAC) early (≤4 days) versus later (≥5 days) after onset of ischaemic stroke."^^xsd:string ;
    oe:belongsToSpecialty "Cardiology" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_atrial_fibrillation_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_atrial_fibrillation_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_atrial_fibrillation_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_atrial_fibrillation_efficacy-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/apixaban> oe:treats <https://example.org/openevidence/diseases/atrial_fibrillation> .
