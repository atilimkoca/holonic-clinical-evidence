@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom1032 a oe:Symptom ;
    rdfs:label "Symptom-1032"@en .

oeevt:entry1032 a holon:EntityEntry ;
    holon:entity oed:disease1032 ;
    holon:entryMode "topic-match" .

oeevt:ev1032_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1032_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.86 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q1032 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1032 ;
    oe:effectiveness "effective" .

oeevt:ev1032_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1032_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.81 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:q1032 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1032 ;
    oe:effectiveness "effective" .

oeevt:ev1032_0-tt rdf:object oed:disease1032 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1032 .

oeevt:ev1032_1-tt rdf:object oed:disease1032 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1032 .

oedrug:drug1032 a oe:Drug ;
    rdfs:label "Drug-1032"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease1032 .

oeq:q1032 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 1032"@en ;
    holon:evidenceQualityThreshold 0.50 ;
    holon:hasBoundaryGraph oeq:q1032-bnd ;
    holon:hasContextGraph oeq:q1032-ctx ;
    holon:hasInteriorGraph oeq:q1032-int ;
    holon:hasProjectionGraph oeq:q1032-prj ;
    holon:narrativeFunction "Establishes Drug-1032 as first-line for Disease-1032"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-1032 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Pulmonology" ;
    oe:questionText "What is the first-line treatment for Disease-1032?"^^xsd:string .

oesrc:src1032 a oe:SystematicReview ;
    rdfs:label "Source-1032"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30001032"^^xsd:string .

oed:disease1032 a oe:Disease ;
    rdfs:label "Disease-1032"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

