@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom1029 a oe:Symptom ;
    rdfs:label "Symptom-1029"@en .

oeevt:entry1029 a holon:EntityEntry ;
    holon:entity oed:disease1029 ;
    holon:entryMode "topic-match" .

oeevt:ev1029_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1029_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.78 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q1029 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1029 ;
    oe:effectiveness "effective" .

oeevt:ev1029_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1029_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.85 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:q1029 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1029 ;
    oe:effectiveness "effective" .

oeevt:ev1029_0-tt rdf:object oed:disease1029 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1029 .

oeevt:ev1029_1-tt rdf:object oed:disease1029 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1029 .

oedrug:drug1029 a oe:Drug ;
    rdfs:label "Drug-1029"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease1029 .

oeq:q1029 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 1029"@en ;
    holon:evidenceQualityThreshold 0.50 ;
    holon:hasBoundaryGraph oeq:q1029-bnd ;
    holon:hasContextGraph oeq:q1029-ctx ;
    holon:hasInteriorGraph oeq:q1029-int ;
    holon:hasProjectionGraph oeq:q1029-prj ;
    holon:narrativeFunction "Establishes Drug-1029 as first-line for Disease-1029"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-1029 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Endocrinology" ;
    oe:questionText "What is the first-line treatment for Disease-1029?"^^xsd:string .

oesrc:src1029 a oe:SystematicReview ;
    rdfs:label "Source-1029"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30001029"^^xsd:string .

oed:disease1029 a oe:Disease ;
    rdfs:label "Disease-1029"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

