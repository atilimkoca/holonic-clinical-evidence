<https://example.org/openevidence/questions/q_schizophrenia_treatment> a holon:ClinicalQuestionHolon ;
    oe:questionText "What is the recommended first-line pharmacological treatment for Schizophrenia?"^^xsd:string ;
    oe:answerText "Antipsychotic drugs are the established treatment for acute schizophrenia but differ in receptor-binding profiles. In 2024, a new-in-class muscarinic receptor agonist (xanomeline-trospium) was licenced, acting upstream of antidopaminergic agents, and providing hope to decrease the adverse effects burden of antipsychotics."^^xsd:string ;
    oe:belongsToSpecialty "Psychiatry" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_schizophrenia_treatment-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_schizophrenia_treatment-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_schizophrenia_treatment-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_schizophrenia_treatment-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/risperidone> oe:treats <https://example.org/openevidence/diseases/schizophrenia> .
