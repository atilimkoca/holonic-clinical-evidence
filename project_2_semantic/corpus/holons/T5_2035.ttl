@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom2035 a oe:Symptom ;
    rdfs:label "Symptom-2035"@en .

oeevt:entry2035 a holon:EntityEntry ;
    holon:entity oed:disease2035 ;
    holon:entryMode "topic-match" .

oeevt:ev2035_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2035_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.78 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q2035 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src2035 ;
    oe:effectiveness "effective" .

oeevt:ev2035_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2035_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.74 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q2035 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src2035 ;
    oe:effectiveness "effective" .

oeevt:ev2035_partner a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2035_partner-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.82 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q2035_partner ;
    holon:recordedOn "2021-01-01"^^xsd:date ;
    oe:cites oesrc:src2035 ;
    oe:effectiveness "ineffective" .

oeevt:ev2035_0-tt rdf:object oed:disease2035 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2035 .

oeevt:ev2035_1-tt rdf:object oed:disease2035 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2035 .

oeevt:ev2035_partner-tt rdf:object oed:disease2035 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2035 .

oeq:q2035_partner a holon:ClinicalQuestionHolon ;
    holon:evidenceQualityThreshold 0.50 ;
    holon:hasBoundaryGraph oeq:q2035_partner-bnd ;
    holon:hasContextGraph oeq:q2035_partner-ctx ;
    holon:hasInteriorGraph oeq:q2035_partner-int ;
    holon:hasProjectionGraph oeq:q2035_partner-prj ;
    holon:narrativeFunction "Contradicts the first holon"@en ;
    holon:summaryConfidence 0.80 ;
    oe:answerText "Evidence suggests no benefit."^^xsd:string ;
    oe:belongsToSpecialty "Cardiology" ;
    oe:questionText "Is Drug-2035 effective for Disease-2035?"^^xsd:string .

oeq:q2035 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 2035"@en ;
    holon:evidenceQualityThreshold 0.50 ;
    holon:hasBoundaryGraph oeq:q2035-bnd ;
    holon:hasContextGraph oeq:q2035-ctx ;
    holon:hasInteriorGraph oeq:q2035-int ;
    holon:hasProjectionGraph oeq:q2035-prj ;
    holon:narrativeFunction "Establishes Drug-2035 as first-line for Disease-2035"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-2035 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Psychiatry" ;
    oe:questionText "What is the first-line treatment for Disease-2035?"^^xsd:string .

oedrug:drug2035 a oe:Drug ;
    rdfs:label "Drug-2035"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease2035 .

oesrc:src2035 a oe:SystematicReview ;
    rdfs:label "Source-2035"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30002035"^^xsd:string .

oed:disease2035 a oe:Disease ;
    rdfs:label "Disease-2035"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

