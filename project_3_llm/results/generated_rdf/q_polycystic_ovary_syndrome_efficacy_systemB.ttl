<https://example.org/openevidence/questions/q_polycystic_ovary_syndrome_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is metformin compared with other agents for Polycystic Ovary Syndrome?"^^xsd:string ;
    oe:answerText "This study aimed to assess the effects of metformin (MET) monotherapy versus a combination of semaglutide and MET on weight, metabolism, reproductive function, and inflammatory markers in women with polycystic ovary syndrome (PCOS). A total of 100 overweight or obese women with PCOS diagnosed according to the Rotterdam criteria were randomly assigned to two groups: MET (1000 mg twice daily [BID] for 16 weeks) and combination therapy (COM) (1000  mg MET BID plus 1- mg semaglutide once weekly [QW] for 16 weeks)."^^xsd:string ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_polycystic_ovary_syndrome_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_polycystic_ovary_syndrome_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_polycystic_ovary_syndrome_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_polycystic_ovary_syndrome_efficacy-con> .

<https://example.org/openevidence/drugs/metformin> oe:treats <https://example.org/openevidence/diseases/polycystic_ovary_syndrome> .
<https://example.org/openevidence/generated/ev_q_polycystic_ovary_syndrome_efficacy_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_polycystic_ovary_syndrome_efficacy_0-tt> ;
    holon:confidence "0.89"^^xsd:decimal ;
    holon:evidenceLevel "Level-1B" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/40713699> ;
    holon:inHolon <https://example.org/openevidence/questions/q_polycystic_ovary_syndrome_efficacy> ;
    oe:effectiveness "effective" .
<https://example.org/openevidence/generated/ev_q_polycystic_ovary_syndrome_efficacy_0-tt> rdf:subject <https://example.org/openevidence/drugs/metformin> ;
    rdf:predicate oe:treats ;
    rdf:object <https://example.org/openevidence/diseases/polycystic_ovary_syndrome> .

