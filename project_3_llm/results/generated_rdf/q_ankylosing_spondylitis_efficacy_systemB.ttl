<https://example.org/openevidence/questions/q_ankylosing_spondylitis_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is adalimumab compared with other agents for Ankylosing Spondylitis?"^^xsd:string ;
    oe:answerText "To evaluate the efficacy and safety of upadacitinib, a Janus kinase inhibitor, in patients with active ankylosing spondylitis (AS) with an inadequate response (IR) to biological disease-modifying antirheumatic drugs (bDMARDs). Adults with active AS who met modified New York criteria and had an IR to one or two bDMARDs (tumour necrosis factor or interleukin-17 inhibitors) were randomised 1:1 to oral upadacitinib 15 mg once daily or placebo."^^xsd:string ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_ankylosing_spondylitis_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_ankylosing_spondylitis_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_ankylosing_spondylitis_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_ankylosing_spondylitis_efficacy-con> .

<https://example.org/openevidence/drugs/adalimumab> oe:treats <https://example.org/openevidence/diseases/ankylosing_spondylitis> .
<https://example.org/openevidence/generated/ev_q_ankylosing_spondylitis_efficacy_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_ankylosing_spondylitis_efficacy_0-tt> ;
    holon:confidence "0.91"^^xsd:decimal ;
    holon:evidenceLevel "Level-1B" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/35788492> ;
    holon:inHolon <https://example.org/openevidence/questions/q_ankylosing_spondylitis_efficacy> ;
    oe:effectiveness "effective" .
<https://example.org/openevidence/generated/ev_q_ankylosing_spondylitis_efficacy_0-tt> rdf:subject <https://example.org/openevidence/drugs/adalimumab> ;
    rdf:predicate oe:treats ;
    rdf:object <https://example.org/openevidence/diseases/ankylosing_spondylitis> .

<https://example.org/openevidence/drugs/levothyroxine> oe:treats <https://example.org/openevidence/diseases/hypothyroidism> .   # ungrounded (naive)
