<https://example.org/openevidence/questions/q_cirrhosis_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is furosemide compared with other agents for Cirrhosis?"^^xsd:string ;
    oe:answerText "There is uncertainty regarding the hepatic efficacy of glucagon-like peptide-1 receptor agonists (GLP-1RAs) in metabolic dysfunction-associated steatotic liver disease (MASLD) or steatohepatitis (MASH). We performed a meta-analysis of randomised controlled trials (RCTs) to examine the efficacy of GLP-1RAs in treating MASLD or MASH."^^xsd:string ;
    oe:belongsToSpecialty "Gastroenterology" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_cirrhosis_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_cirrhosis_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_cirrhosis_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_cirrhosis_efficacy-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/furosemide> oe:treats <https://example.org/openevidence/diseases/cirrhosis> .
<https://example.org/openevidence/generated/ev_q_cirrhosis_efficacy_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_cirrhosis_efficacy_0-tt> ;
    holon:confidence "0.95"^^xsd:decimal ;
    holon:evidenceLevel "Level-1A" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/40736113> ;
    holon:inHolon <https://example.org/openevidence/questions/q_cirrhosis_efficacy> ;
    oe:effectiveness "effective" .
<https://example.org/openevidence/generated/ev_q_cirrhosis_efficacy_0-tt> rdf:subject <https://example.org/openevidence/drugs/furosemide> ;
    rdf:predicate oe:treats ;
    rdf:object <https://example.org/openevidence/diseases/cirrhosis> .

