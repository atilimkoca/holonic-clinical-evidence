<https://example.org/openevidence/questions/q_crohn_disease_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is adalimumab compared with other agents for Crohn Disease?"^^xsd:string ;
    oe:answerText "Subcutaneous (SC) induction and maintenance with guselkumab was evaluated in adult participants with moderately to severely active Crohn's disease. The Phase 3 double-blind, placebo-controlled, treat-through GRAVITI study randomized 347 participants 1:1:1 to guselkumab 400 mg SC every 4 weeks→100 mg SC every 8 weeks (n = 115), guselkumab 400 mg SC every 4 weeks→200 mg SC every 4 weeks (n = 115), or placebo (n = 117)."^^xsd:string ;
    oe:belongsToSpecialty "Gastroenterology" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_crohn_disease_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_crohn_disease_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_crohn_disease_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_crohn_disease_efficacy-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/adalimumab> oe:treats <https://example.org/openevidence/diseases/crohn_disease> .
<https://example.org/openevidence/generated/ev_q_crohn_disease_efficacy_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_crohn_disease_efficacy_0-tt> ;
    holon:confidence "0.93"^^xsd:decimal ;
    holon:evidenceLevel "Level-1B" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/40113101> ;
    holon:inHolon <https://example.org/openevidence/questions/q_crohn_disease_efficacy> ;
    oe:effectiveness "effective" .
<https://example.org/openevidence/generated/ev_q_crohn_disease_efficacy_0-tt> rdf:subject <https://example.org/openevidence/drugs/adalimumab> ;
    rdf:predicate oe:treats ;
    rdf:object <https://example.org/openevidence/diseases/crohn_disease> .

