    holon:hasContextGraph oeq:q_parkinson_disease_efficacy-ctx ;
    holon:hasInteriorGraph oeq:q_parkinson_disease_efficacy-int ;
    holon:hasProjectionGraph oeq:q_parkinson_disease_efficacy-prj ;
    holon:narrativeFunction "Summarises evidence on managing Parkinson Disease with levodopa."^^xsd:string ;
    holon:prerequisiteFor oeq:q_parkinson_disease_safety ;
    holon:recordedOn "2026-05-01"^^xsd:date ;
    holon:summaryConfidence 0.57 ;
    oe:aboutDisease oed:parkinson_disease ;
    oe:answerText "Microglial activation-induced neuroinflammation and impaired neuronal mitophagy are recognized as pivotal pathogeneses in Parkinson's disease (PD). However, the role of microglial mitophagy in microglial activation during PD development remains unclear, and therapeutic interventions targeting this interaction are lacking."^^xsd:string ;
