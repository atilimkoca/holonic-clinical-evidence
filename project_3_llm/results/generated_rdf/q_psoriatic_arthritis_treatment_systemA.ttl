<https://example.org/openevidence/questions/q_psoriatic_arthritis_treatment> a holon:ClinicalQuestionHolon ;
    oe:questionText "What is the recommended first-line pharmacological treatment for Psoriatic Arthritis?"^^xsd:string ;
    oe:answerText "New modes of action and more data on the efficacy and safety of existing drugs in psoriatic arthritis (PsA) required an update of the EULAR 2019 recommendations for the pharmacological treatment of PsA. Following EULAR standardised operating procedures, the process included a systematic literature review and a consensus meeting of 36 international experts in April 2023."^^xsd:string ;
    oe:belongsToSpecialty "Rheumatology" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_psoriatic_arthritis_treatment-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_psoriatic_arthritis_treatment-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_psoriatic_arthritis_treatment-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_psoriatic_arthritis_treatment-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/methotrexate> oe:treats <https://example.org/openevidence/diseases/psoriatic_arthritis> .
