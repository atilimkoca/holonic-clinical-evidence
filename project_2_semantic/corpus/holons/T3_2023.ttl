@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom2023 a oe:Symptom ;
    rdfs:label "Symptom-2023"@en .

oeevt:entry2023 a holon:EntityEntry ;
    holon:entity oed:disease2023 ;
    holon:entryMode "topic-match" .

oeevt:ev2023_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2023_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.88 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:q2023 ;
    holon:recordedOn "2015-01-01"^^xsd:date ;
    oe:cites oesrc:src2023 ;
    oe:effectiveness "effective" .

oeevt:ev2023_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2023_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.81 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:q2023 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src2023 ;
    oe:effectiveness "effective" .

oeevt:ev2023_0-tt rdf:object oed:disease2023 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2023 .

oeevt:ev2023_1-tt rdf:object oed:disease2023 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2023 .

oedrug:drug2023 a oe:Drug ;
    rdfs:label "Drug-2023"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease2023 .

oeq:q2023 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 2023"@en ;
    holon:evidenceQualityThreshold 0.50 ;
    holon:hasBoundaryGraph oeq:q2023-bnd ;
    holon:hasContextGraph oeq:q2023-ctx ;
    holon:hasInteriorGraph oeq:q2023-int ;
    holon:hasProjectionGraph oeq:q2023-prj ;
    holon:narrativeFunction "Establishes Drug-2023 as first-line for Disease-2023"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-2023 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Pulmonology" ;
    oe:questionText "What is the first-line treatment for Disease-2023?"^^xsd:string .

oesrc:src2023 a oe:SystematicReview ;
    rdfs:label "Source-2023"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30002023"^^xsd:string .

oed:disease2023 a oe:Disease ;
    rdfs:label "Disease-2023"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

