@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom2041 a oe:Symptom ;
    rdfs:label "Symptom-2041"@en .

oeevt:entry2041 a holon:EntityEntry ;
    holon:entity oed:disease2041 ;
    holon:entryMode "topic-match" .

oeevt:ev2041_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2041_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.81 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:q2041 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src2041 ;
    oe:effectiveness "effective" .

oeevt:ev2041_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2041_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.87 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q2041 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src2041 ;
    oe:effectiveness "effective" .

oeevt:ev2041_partner a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2041_partner-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.82 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q2041_partner ;
    holon:recordedOn "2021-01-01"^^xsd:date ;
    oe:cites oesrc:src2041 ;
    oe:effectiveness "ineffective" .

oeevt:ev2041_0-tt rdf:object oed:disease2041 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2041 .

oeevt:ev2041_1-tt rdf:object oed:disease2041 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2041 .

oeevt:ev2041_partner-tt rdf:object oed:disease2041 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2041 .

oeq:q2041_partner a holon:ClinicalQuestionHolon ;
    holon:evidenceQualityThreshold 0.50 ;
    holon:hasBoundaryGraph oeq:q2041_partner-bnd ;
    holon:hasContextGraph oeq:q2041_partner-ctx ;
    holon:hasInteriorGraph oeq:q2041_partner-int ;
    holon:hasProjectionGraph oeq:q2041_partner-prj ;
    holon:narrativeFunction "Contradicts the first holon"@en ;
    holon:summaryConfidence 0.80 ;
    oe:answerText "Evidence suggests no benefit."^^xsd:string ;
    oe:belongsToSpecialty "Cardiology" ;
    oe:questionText "Is Drug-2041 effective for Disease-2041?"^^xsd:string .

oeq:q2041 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 2041"@en ;
    holon:evidenceQualityThreshold 0.50 ;
    holon:hasBoundaryGraph oeq:q2041-bnd ;
    holon:hasContextGraph oeq:q2041-ctx ;
    holon:hasInteriorGraph oeq:q2041-int ;
    holon:hasProjectionGraph oeq:q2041-prj ;
    holon:narrativeFunction "Establishes Drug-2041 as first-line for Disease-2041"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-2041 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Cardiology" ;
    oe:questionText "What is the first-line treatment for Disease-2041?"^^xsd:string .

oedrug:drug2041 a oe:Drug ;
    rdfs:label "Drug-2041"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease2041 .

oesrc:src2041 a oe:SystematicReview ;
    rdfs:label "Source-2041"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30002041"^^xsd:string .

oed:disease2041 a oe:Disease ;
    rdfs:label "Disease-2041"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

