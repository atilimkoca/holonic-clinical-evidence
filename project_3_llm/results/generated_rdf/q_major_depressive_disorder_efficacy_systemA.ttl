<https://example.org/openevidence/questions/q_major_depressive_disorder_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is sertraline compared with other agents for Major Depressive Disorder?"^^xsd:string ;
    oe:answerText "To evaluate the efficacy and safety of oral zuranolone for 14 days, compared with placebo, in Japanese patients with major depressive disorder (MDD). This multicenter, Phase 3 study was conducted in two parts (70 sites; Japan) including a randomized, double-blind, placebo-controlled, parallel-group part presented herein."^^xsd:string ;
    oe:belongsToSpecialty "Psychiatry" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_major_depressive_disorder_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_major_depressive_disorder_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_major_depressive_disorder_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_major_depressive_disorder_efficacy-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/sertraline> oe:treats <https://example.org/openevidence/diseases/major_depressive_disorder> .
<https://example.org/openevidence/generated/ev_q_major_depressive_disorder_efficacy_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_major_depressive_disorder_efficacy_0-tt> ;
    holon:confidence "0.92"^^xsd:decimal ;
    holon:evidenceLevel "Level-1B" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/41251319> ;
    holon:inHolon <https://example.org/openevidence/questions/q_major_depressive_disorder_efficacy> ;
    oe:effectiveness "effective" .
<https://example.org/openevidence/generated/ev_q_major_depressive_disorder_efficacy_0-tt> rdf:subject <https://example.org/openevidence/drugs/sertraline> ;
