    oeevt:ev_q_chronic_kidney_disease_safety-tt rdf:object oesym:edema ;
        rdf:predicate oe:causesSideEffect ;
        rdf:subject oedrug:lisinopril .

    oeq:q_chronic_kidney_disease_safety oe:answerText "To investigate the renal outcomes of dipeptidyl peptidase 4 (DPP-4) inhibitors, glucagon-like peptide-1 (GLP-1) receptor agonists, and sodium-glucose transport protein-2 (SGLT-2) inhibitors in patients with type 2 diabetes mellitus (T2DM) with chronic renal disease (CKD). PubMed, Embase, Cochrane CENTRAL, and ClinicalTrials.gov were searched through July 2025 for randomized controlled trials with ≥24 weeks of follow-up in patients with T2DM and CKD."^^xsd:string ;
        oe:cites oesrc:40880481,
            oesrc:41027876,
            oesrc:41147324,
            oesrc:41369941 ;
        oe:questionText "What are the main adverse effects and contraindications of treating Chronic Kidney Disease with lisinopril?"^^xsd:string .

    oedrug:lisinopril oe:causesSideEffect oesym:edema .
}

oeq:q_acute_kidney_injury_safety-int {
