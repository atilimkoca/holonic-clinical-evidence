    holon:recordedOn "2026-01-01"^^xsd:date ;
    holon:summaryConfidence 0.97 ;
    oe:aboutDisease oed:chronic_kidney_disease ;
    oe:answerText "To investigate the renal outcomes of dipeptidyl peptidase 4 (DPP-4) inhibitors, glucagon-like peptide-1 (GLP-1) receptor agonists, and sodium-glucose transport protein-2 (SGLT-2) inhibitors in patients with type 2 diabetes mellitus (T2DM) with chronic renal disease (CKD). PubMed, Embase, Cochrane CENTRAL, and ClinicalTrials.gov were searched through July 2025 for randomized controlled trials with ≥24 weeks of follow-up in patients with T2DM and CKD."^^xsd:string ;
    oe:belongsToSpecialty "Nephrology" ;
