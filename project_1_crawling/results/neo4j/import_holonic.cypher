MATCH (x:Drug {id:'lisinopril'}),(d:Disease {id:'hypertension'}) MERGE (x)-[:TREATS {confidence:0.56, evidenceLevel:'Level-3', holon:'q_hypertension_treatment', recordedOn:'2026-03-07'}]->(d);
MATCH (x:Drug {id:'lisinopril'}),(d:Disease {id:'hypertension'}) MERGE (x)-[:TREATS {confidence:0.55, evidenceLevel:'Level-3', holon:'q_hypertension_efficacy', recordedOn:'2026-05-01'}]->(d);
