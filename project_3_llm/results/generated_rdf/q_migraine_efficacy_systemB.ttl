<https://example.org/openevidence/questions/q_migraine_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is sumatriptan compared with other agents for Migraine?"^^xsd:string ;
    oe:answerText "Migraine is a primary headache disorder characterized by recurrent disabling attacks. Pharmacologic treatment of acute migraine episodes should be individualized based on route of administration, cost, contraindications, and adverse effects."^^xsd:string ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_migraine_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_migraine_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_migraine_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_migraine_efficacy-con> .

<https://example.org/openevidence/drugs/sumatriptan> oe:treats <https://example.org/openevidence/diseases/migraine> .
<https://example.org/openevidence/generated/ev_q_migraine_efficacy_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_migraine_efficacy_0-tt> ;
    holon:confidence "0.27"^^xsd:decimal ;
    holon:evidenceLevel "Level-5" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/40238974> ;
    holon:inHolon <https://example.org/openevidence/questions/q_migraine_efficacy> ;
    oe:effectiveness "inconclusive" .
<https://example.org/openevidence/generated/ev_q_migraine_efficacy_0-tt> rdf:subject <https://example.org/openevidence/drugs/sumatriptan> ;
    rdf:predicate oe:treats ;
    rdf:object <https://example.org/openevidence/diseases/migraine> .

<https://example.org/openevidence/drugs/atorvastatin> oe:treats <https://example.org/openevidence/diseases/coronary_artery_disease> .   # ungrounded (naive)
<https://example.org/openevidence/drugs/levothyroxine> oe:treats <https://example.org/openevidence/diseases/hypothyroidism> .   # ungrounded (naive)
