oedrug:prednisone oe:treats oed:addison_disease .

oeevt:ev_q_addison_disease_efficacy-tt rdf:object oed:addison_disease ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:prednisone .

oeq:q_addison_disease_efficacy a holon:ClinicalQuestionHolon ;
    rdfs:label "How effective is prednisone compared with other agents for Addison Disease?"@en ;
