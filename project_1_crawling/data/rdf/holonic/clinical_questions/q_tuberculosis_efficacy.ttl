oedrug:isoniazid oe:treats oed:tuberculosis .

oeevt:ev_q_tuberculosis_efficacy-tt rdf:object oed:tuberculosis ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:isoniazid .

oeq:q_tuberculosis_efficacy a holon:ClinicalQuestionHolon ;
    rdfs:label "How effective is isoniazid compared with other agents for Tuberculosis?"@en ;
    prov:generatedAtTime "2026-01-01T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
