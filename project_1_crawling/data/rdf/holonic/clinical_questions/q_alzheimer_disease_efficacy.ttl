oeevt:entry_q_alzheimer_disease_efficacy a holon:EntityEntry ;
    holon:entity oed:alzheimer_disease ;
    holon:entryMode "topic-match" .

oeevt:ev_q_alzheimer_disease_efficacy a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev_q_alzheimer_disease_efficacy-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.88 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:q_alzheimer_disease_efficacy ;
    holon:recordedOn "2026-03-21"^^xsd:date ;
    oe:cites oesrc:41405855 ;
    oe:effectiveness "effective" .

oedrug:donepezil oe:treats oed:alzheimer_disease .

oeevt:ev_q_alzheimer_disease_efficacy-tt rdf:object oed:alzheimer_disease ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:donepezil .

oeq:q_alzheimer_disease_efficacy a holon:ClinicalQuestionHolon ;
    rdfs:label "How effective is donepezil compared with other agents for Alzheimer Disease?"@en ;
    prov:generatedAtTime "2026-03-21T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
    holon:aggregateConfidence 0.49 ;
    holon:evidenceQualityThreshold 0.5 ;
    holon:hasBoundaryGraph oeq:q_alzheimer_disease_efficacy-bnd ;
    holon:hasContextGraph oeq:q_alzheimer_disease_efficacy-ctx ;
    holon:hasInteriorGraph oeq:q_alzheimer_disease_efficacy-int ;
    holon:hasProjectionGraph oeq:q_alzheimer_disease_efficacy-prj ;
    holon:narrativeFunction "Summarises evidence on managing Alzheimer Disease with donepezil."^^xsd:string ;
    holon:prerequisiteFor oeq:q_alzheimer_disease_safety ;
    holon:recordedOn "2026-03-21"^^xsd:date ;
    holon:summaryConfidence 0.88 ;
    oe:aboutDisease oed:alzheimer_disease ;
    oe:answerText "Neuroscientific, epidemiological, and electronic health record studies implicate herpes simplex virus (HSV) as potentially etiological for Alzheimer disease (AD). To compare the efficacy and adverse effects of valacyclovir vs placebo in participants with early symptomatic AD and HSV seropositivity (HSV-1 or HSV-2)."^^xsd:string ;
    oe:belongsToSpecialty "Neurology" ;
    oe:cites oesrc:41405855,
        oesrc:41419667,
        oesrc:41792133,
        oesrc:41864895 ;
    oe:questionText "How effective is donepezil compared with other agents for Alzheimer Disease?"^^xsd:string .

