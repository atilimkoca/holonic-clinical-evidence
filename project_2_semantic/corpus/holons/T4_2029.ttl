@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom2029 a oe:Symptom ;
    rdfs:label "Symptom-2029"@en .

oeevt:entry2029 a holon:EntityEntry ;
    holon:entity oed:disease2029 ;
    holon:entryMode "topic-match" .

oeevt:ev2029_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2029_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.30 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q2029 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src2029 ;
    oe:effectiveness "effective" .

oeevt:ev2029_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2029_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.95 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q2029 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src2029 ;
    oe:effectiveness "effective" .

oeevt:ev2029_0-tt rdf:object oed:disease2029 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2029 .

oeevt:ev2029_1-tt rdf:object oed:disease2029 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2029 .

oedrug:drug2029 a oe:Drug ;
    rdfs:label "Drug-2029"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease2029 .

oeq:q2029 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 2029"@en ;
    holon:evidenceQualityThreshold 0.50 ;
    holon:hasBoundaryGraph oeq:q2029-bnd ;
    holon:hasContextGraph oeq:q2029-ctx ;
    holon:hasInteriorGraph oeq:q2029-int ;
    holon:hasProjectionGraph oeq:q2029-prj ;
    holon:narrativeFunction "Establishes Drug-2029 as first-line for Disease-2029"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-2029 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Nephrology" ;
    oe:questionText "What is the first-line treatment for Disease-2029?"^^xsd:string .

oesrc:src2029 a oe:SystematicReview ;
    rdfs:label "Source-2029"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30002029"^^xsd:string .

oed:disease2029 a oe:Disease ;
    rdfs:label "Disease-2029"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

