<https://example.org/openevidence/questions/q_generalized_anxiety_disorder_treatment> a holon:ClinicalQuestionHolon ;
    oe:questionText "What is the recommended first-line pharmacological treatment for Generalized Anxiety Disorder?"^^xsd:string ;
    oe:answerText "Cannabidiol (CBD), as one of the phytocannabinoids, has a wide range of therapeutic properties for various neuropsychiatric disorders due to central nervous system effects. These therapeutic properties demonstrated by preclinical and clinical studies encompass more than just anticonvulsant, anti-arthritic, analgesic, anti-inflammatory, antioxidant, antitumor, antiemetic, antipsychotic and neuroprotective effects."^^xsd:string ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_generalized_anxiety_disorder_treatment-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_generalized_anxiety_disorder_treatment-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_generalized_anxiety_disorder_treatment-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_generalized_anxiety_disorder_treatment-con> .

