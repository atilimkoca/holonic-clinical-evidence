oeevt:entry_q_crohn_disease_efficacy a holon:EntityEntry ;
    holon:entity oed:crohn_disease ;
    holon:entryMode "topic-match" .

oeevt:ev_q_crohn_disease_efficacy a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev_q_crohn_disease_efficacy-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.93 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:q_crohn_disease_efficacy ;
    holon:recordedOn "2025-08-01"^^xsd:date ;
