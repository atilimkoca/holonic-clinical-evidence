    oeevt:ev_q_polycystic_ovary_syndrome_efficacy-tt rdf:object oed:polycystic_ovary_syndrome ;
        rdf:predicate oe:treats ;
        rdf:subject oedrug:metformin .

    oeq:q_polycystic_ovary_syndrome_efficacy oe:answerText "This study aimed to assess the effects of metformin (MET) monotherapy versus a combination of semaglutide and MET on weight, metabolism, reproductive function, and inflammatory markers in women with polycystic ovary syndrome (PCOS). A total of 100 overweight or obese women with PCOS diagnosed according to the Rotterdam criteria were randomly assigned to two groups: MET (1000 mg twice daily [BID] for 16 weeks) and combination therapy (COM) (1000  mg MET BID plus 1- mg semaglutide once weekly [QW] for 16 weeks)."^^xsd:string ;
        oe:cites oesrc:38725974,
            oesrc:39201722,
            oesrc:39353946,
            oesrc:40713699 ;
        oe:questionText "How effective is metformin compared with other agents for Polycystic Ovary Syndrome?"^^xsd:string .

    oedrug:metformin oe:treats oed:polycystic_ovary_syndrome .
}

