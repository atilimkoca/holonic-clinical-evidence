<https://example.org/openevidence/questions/q_diabetic_nephropathy_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is lisinopril compared with other agents for Diabetic Nephropathy?"^^xsd:string ;
    oe:answerText "Renal fibrosis-characterized by microcirculatory disturbances and endothelial-mesenchymal transition (EndMT)-is a major pathological feature of chronic kidney disease (CKD) and remains a significant therapeutic challenge. The mechanosensitive ion channel Piezo1 plays a pivotal role in endothelial mechanotransduction and has been implicated in fibrogenesis, yet specific pharmacological interventions targeting Piezo1 are lacking."^^xsd:string ;
    oe:belongsToSpecialty "Nephrology" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_diabetic_nephropathy_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_diabetic_nephropathy_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_diabetic_nephropathy_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_diabetic_nephropathy_efficacy-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/lisinopril> oe:treats <https://example.org/openevidence/diseases/diabetic_nephropathy> .
<https://example.org/openevidence/generated/ev_q_diabetic_nephropathy_efficacy_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_diabetic_nephropathy_efficacy_0-tt> ;
    holon:confidence "0.52"^^xsd:decimal ;
    holon:evidenceLevel "Level-3" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/40653265> ;
    holon:inHolon <https://example.org/openevidence/questions/q_diabetic_nephropathy_efficacy> ;
    oe:effectiveness "effective" .
<https://example.org/openevidence/generated/ev_q_diabetic_nephropathy_efficacy_0-tt> rdf:subject <https://example.org/openevidence/drugs/lisinopril> ;
    rdf:predicate oe:treats ;
    rdf:object <https://example.org/openevidence/diseases/diabetic_nephropathy> .

