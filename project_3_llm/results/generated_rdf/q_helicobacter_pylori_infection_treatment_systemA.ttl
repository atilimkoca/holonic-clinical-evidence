<https://example.org/openevidence/questions/q_helicobacter_pylori_infection_treatment> a holon:ClinicalQuestionHolon ;
    oe:questionText "What is the recommended first-line pharmacological treatment for Helicobacter Pylori Infection?"^^xsd:string ;
    oe:answerText "Gastric premalignant conditions (GPMC) are common and include atrophic gastritis, gastric intestinal metaplasia, dysplasia, and certain gastric epithelial polyps. GPMC have an increased risk of progression to gastric adenocarcinoma."^^xsd:string ;
    oe:belongsToSpecialty "Infectious Disease" ;
