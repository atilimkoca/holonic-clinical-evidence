<https://example.org/openevidence/questions/q_status_epilepticus_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is levetiracetam compared with other agents for Status Epilepticus?"^^xsd:string ;
    oe:answerText "Status epilepticus is a neurologic emergency defined as a seizure that lasts longer than 5 minutes. This is the most common neurologic emergency in children, and it is associated with significant morbidity and mortality."^^xsd:string ;
    oe:belongsToSpecialty "Neurology" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_status_epilepticus_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_status_epilepticus_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_status_epilepticus_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_status_epilepticus_efficacy-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/levetiracetam> oe:treats <https://example.org/openevidence/diseases/status_epilepticus> .
