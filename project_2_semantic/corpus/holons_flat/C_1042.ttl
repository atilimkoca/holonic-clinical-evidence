@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom1042 a oe:Symptom ;
    rdfs:label "Symptom-1042"@en .

oeevt:ev1042_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1042_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.76 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:chain1042 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1042 ;
    oe:effectiveness "effective" .

oeevt:ev1042_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1042_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.79 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:chain1042 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1042 ;
    oe:effectiveness "effective" .

oeevt:ev1042_0-tt rdf:object oed:disease1042 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1042 .

oeevt:ev1042_1-tt rdf:object oed:disease1042 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1042 .

oedrug:drug1042 a oe:Drug ;
    rdfs:label "Drug-1042"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease1042 .

oeq:chain1042 a holon:EvidenceChainHolon ;
    rdfs:label "Holon 1042"@en ;
    holon:aggregateConfidence 0.78 ;
    holon:narrativeFunction "Establishes Drug-1042 as first-line for Disease-1042"@en ;
    holon:summaryConfidence 0.85 .

oesrc:src1042 a oe:SystematicReview ;
    rdfs:label "Source-1042"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30001042"^^xsd:string .

oed:disease1042 a oe:Disease ;
    rdfs:label "Disease-1042"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

