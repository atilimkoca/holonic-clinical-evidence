oeq:q_colorectal_cancer_treatment a holon:ClinicalQuestionHolon ;
    rdfs:label "What is the recommended first-line pharmacological treatment for Colorectal Cancer?"@en ;
    prov:generatedAtTime "2026-03-01T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
