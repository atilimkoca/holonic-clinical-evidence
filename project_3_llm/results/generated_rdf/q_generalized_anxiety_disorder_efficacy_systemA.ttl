<https://example.org/openevidence/questions/q_generalized_anxiety_disorder_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is escitalopram compared with other agents for Generalized Anxiety Disorder?"^^xsd:string ;
    oe:answerText "Beta-blocker prescriptions for patients with anxiety increased substantially between 2003 and 2018, yet there is no clinical guidance concerning their use. A previous review of propranolol - a beta-blocker - in the treatment of anxiety concluded there was insufficient evidence to support its use."^^xsd:string ;
    oe:belongsToSpecialty "Psychiatry" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_generalized_anxiety_disorder_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_generalized_anxiety_disorder_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_generalized_anxiety_disorder_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_generalized_anxiety_disorder_efficacy-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/escitalopram> oe:treats <https://example.org/openevidence/diseases/generalized_anxiety_disorder> .
