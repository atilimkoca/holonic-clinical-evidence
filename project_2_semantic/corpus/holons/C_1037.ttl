@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom1037 a oe:Symptom ;
    rdfs:label "Symptom-1037"@en .

oeevt:entry1037 a holon:EntityEntry ;
    holon:entity oed:disease1037 ;
    holon:entryMode "topic-match" .

oeevt:ev1037_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1037_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.81 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q1037 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1037 ;
    oe:effectiveness "effective" .

oeevt:ev1037_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1037_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.82 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q1037 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1037 ;
    oe:effectiveness "effective" .

oeevt:ev1037_0-tt rdf:object oed:disease1037 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1037 .

oeevt:ev1037_1-tt rdf:object oed:disease1037 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1037 .

oedrug:drug1037 a oe:Drug ;
    rdfs:label "Drug-1037"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease1037 .

oeq:q1037 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 1037"@en ;
    holon:evidenceQualityThreshold 0.50 ;
    holon:hasBoundaryGraph oeq:q1037-bnd ;
    holon:hasContextGraph oeq:q1037-ctx ;
    holon:hasInteriorGraph oeq:q1037-int ;
    holon:hasProjectionGraph oeq:q1037-prj ;
    holon:narrativeFunction "Establishes Drug-1037 as first-line for Disease-1037"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-1037 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Cardiology" ;
    oe:questionText "What is the first-line treatment for Disease-1037?"^^xsd:string .

oesrc:src1037 a oe:SystematicReview ;
    rdfs:label "Source-1037"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30001037"^^xsd:string .

oed:disease1037 a oe:Disease ;
    rdfs:label "Disease-1037"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

