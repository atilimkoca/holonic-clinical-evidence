oeq:q_atrial_fibrillation_efficacy a holon:ClinicalQuestionHolon ;
    rdfs:label "How effective is apixaban compared with other agents for Atrial Fibrillation?"@en ;
    prov:generatedAtTime "2026-01-22T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
