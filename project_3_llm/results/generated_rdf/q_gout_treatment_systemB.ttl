<https://example.org/openevidence/questions/q_gout_treatment> a holon:ClinicalQuestionHolon ;
    oe:questionText "What is the recommended first-line pharmacological treatment for Gout?"^^xsd:string ;
    oe:answerText "Gout is characterized by deposition of monosodium urate (MSU) crystals in or around joints, tendons, bursae, and other tissues, resulting in painful recurrent flares and tissue damage. Gout is the most common form of inflammatory arthritis, with a prevalence of 5.1% in the United States, affecting 12.1 million adults."^^xsd:string ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_gout_treatment-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_gout_treatment-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_gout_treatment-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_gout_treatment-con> .

<https://example.org/openevidence/drugs/allopurinol> oe:treats <https://example.org/openevidence/diseases/gout> .
