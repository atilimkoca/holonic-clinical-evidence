oeq:q_cardiomyopathy_safety a holon:ClinicalQuestionHolon ;
    rdfs:label "What are the main adverse effects and contraindications of treating Cardiomyopathy with me"@en ;
    prov:generatedAtTime "2026-02-01T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
    holon:aggregateConfidence 0.73 ;
    holon:evidenceQualityThreshold 0.5 ;
    holon:hasBoundaryGraph oeq:q_cardiomyopathy_safety-bnd ;
    holon:hasContextGraph oeq:q_cardiomyopathy_safety-ctx ;
    holon:hasInteriorGraph oeq:q_cardiomyopathy_safety-int ;
    holon:hasProjectionGraph oeq:q_cardiomyopathy_safety-prj ;
    holon:narrativeFunction "Summarises evidence on managing Cardiomyopathy with metoprolol."^^xsd:string ;
    holon:recordedOn "2026-02-01"^^xsd:date ;
    holon:summaryConfidence 0.91 ;
    oe:aboutDisease oed:cardiomyopathy ;
    oe:answerText "Transthyretin amyloid cardiomyopathy (ATTR-CM), caused by deposition of transthyretin amyloid fibrils in the heart, is associated with high morbidity and mortality. In HELIOS-B (A Study to Evaluate Vutrisiran in Patients With Transthyretin Amyloidosis With Cardiomyopathy), the RNA interference therapeutic agent vutrisiran reduced rates of the primary composite outcome of all-cause death and recurrent cardiovascular events among patients with ATTR-CM and had beneficial effects on cardiac structure and function over 30 months."^^xsd:string ;
    oe:belongsToSpecialty "Cardiology" ;
    oe:cites oesrc:40769673,
        oesrc:40864018,
        oesrc:41099677,
        oesrc:41412038 ;
    oe:questionText "What are the main adverse effects and contraindications of treating Cardiomyopathy with metoprolol?"^^xsd:string .

