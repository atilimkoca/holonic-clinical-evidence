oeq:q_ankylosing_spondylitis_efficacy a holon:ClinicalQuestionHolon ;
    rdfs:label "How effective is adalimumab compared with other agents for Ankylosing Spondylitis?"@en ;
    prov:generatedAtTime "2025-06-01T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
    holon:aggregateConfidence 0.69 ;
    holon:evidenceQualityThreshold 0.5 ;
    holon:hasBoundaryGraph oeq:q_ankylosing_spondylitis_efficacy-bnd ;
    holon:hasContextGraph oeq:q_ankylosing_spondylitis_efficacy-ctx ;
    holon:hasInteriorGraph oeq:q_ankylosing_spondylitis_efficacy-int ;
    holon:hasProjectionGraph oeq:q_ankylosing_spondylitis_efficacy-prj ;
    holon:narrativeFunction "Summarises evidence on managing Ankylosing Spondylitis with adalimumab."^^xsd:string ;
    holon:prerequisiteFor oeq:q_ankylosing_spondylitis_safety ;
    holon:recordedOn "2025-06-01"^^xsd:date ;
    holon:summaryConfidence 0.91 ;
    oe:aboutDisease oed:ankylosing_spondylitis ;
    oe:answerText "To evaluate the efficacy and safety of upadacitinib, a Janus kinase inhibitor, in patients with active ankylosing spondylitis (AS) with an inadequate response (IR) to biological disease-modifying antirheumatic drugs (bDMARDs). Adults with active AS who met modified New York criteria and had an IR to one or two bDMARDs (tumour necrosis factor or interleukin-17 inhibitors) were randomised 1:1 to oral upadacitinib 15 mg once daily or placebo."^^xsd:string ;
    oe:belongsToSpecialty "Rheumatology" ;
    oe:cites oesrc:35788492,
        oesrc:36688014,
        oesrc:36754548,
        oesrc:39533349 ;
    oe:questionText "How effective is adalimumab compared with other agents for Ankylosing Spondylitis?"^^xsd:string .

