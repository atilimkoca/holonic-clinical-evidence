    holon:narrativeFunction "Summarises evidence on managing Non-Hodgkin Lymphoma with rituximab."^^xsd:string ;
    holon:recordedOn "2026-03-01"^^xsd:date ;
    holon:summaryConfidence 0.9 ;
    oe:aboutDisease oed:non_hodgkin_lymphoma ;
    oe:answerText "Ibrutinib, a Bruton tyrosine kinase inhibitor, prolongs progression-free survival when added to immunochemotherapy as first line treatment. The ENRICH trial compared the chemotherapy-free combination of ibrutinib and the anti-CD20 antibody rituximab (ibrutinib-rituximab) with standard immunochemotherapy (R-CHOP [rituximab-cyclophosphamide, doxorubicin, vincristine, and prednisolone] or bendamustine-rituximab) in patients 60 years and older with untreated mantle-cell lymphoma."^^xsd:string ;
    oe:belongsToSpecialty "Oncology" ;
    oe:cites oesrc:41052510,
        oesrc:41115257,
        oesrc:41380698,
        oesrc:41410728 ;
    oe:questionText "What are the main adverse effects and contraindications of treating Non-Hodgkin Lymphoma with rituximab?"^^xsd:string .

