@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oegen: <https://example.org/openevidence/generated/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/openevidence/questions/q_asthma_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is salbutamol compared with other agents for Asthma?"^^xsd:string ;
    oe:answerText "Severe asthma affects 5% to 10% of patients with asthma but constitutes close to one-half of the medical costs related to asthma due to higher morbidity and health care utilization. Biologic agents have become a standard of care in those unresponsive to standard treatments yet the choice of biologic agent is complex due to the varying mechanisms of action, efficacies, and lack of head-to-head comparisons."^^xsd:string ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_asthma_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_asthma_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_asthma_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_asthma_efficacy-con> .

<https://example.org/openevidence/drugs/salbutamol> oe:treats <https://example.org/openevidence/diseases/asthma> .
<https://example.org/openevidence/generated/ev_q_asthma_efficacy_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_asthma_efficacy_0-tt> ;
    holon:confidence "0.93"^^xsd:decimal ;
    holon:evidenceLevel "Level-1A" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/41005695> ;
    holon:inHolon <https://example.org/openevidence/questions/q_asthma_efficacy> ;
    oe:effectiveness "effective" .
<https://example.org/openevidence/generated/ev_q_asthma_efficacy_0-tt> rdf:subject <https://example.org/openevidence/drugs/salbutamol> ;
    rdf:predicate oe:treats ;
    rdf:object <https://example.org/openevidence/diseases/asthma> .

<https://example.org/openevidence/drugs/atorvastatin> oe:treats <https://example.org/openevidence/diseases/coronary_artery_disease> .   # ungrounded (naive)
<https://example.org/openevidence/drugs/levothyroxine> oe:treats <https://example.org/openevidence/diseases/hypothyroidism> .   # ungrounded (naive)
<https://example.org/openevidence/drugs/morphine> oe:treats <https://example.org/openevidence/diseases/pancreatitis> .   # ungrounded (naive)
