oeq:q_rheumatoid_arthritis_efficacy a holon:ClinicalQuestionHolon ;
    rdfs:label "How effective is methotrexate compared with other agents for Rheumatoid Arthritis?"@en ;
    prov:generatedAtTime "2026-01-08T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
