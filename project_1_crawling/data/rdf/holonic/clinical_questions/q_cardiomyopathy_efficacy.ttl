oeq:q_cardiomyopathy_efficacy a holon:ClinicalQuestionHolon ;
    rdfs:label "How effective is metoprolol compared with other agents for Cardiomyopathy?"@en ;
    prov:generatedAtTime "2025-12-16T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
    holon:aggregateConfidence 0.65 ;
    holon:evidenceQualityThreshold 0.5 ;
    holon:hasBoundaryGraph oeq:q_cardiomyopathy_efficacy-bnd ;
    holon:hasContextGraph oeq:q_cardiomyopathy_efficacy-ctx ;
    holon:hasInteriorGraph oeq:q_cardiomyopathy_efficacy-int ;
    holon:hasProjectionGraph oeq:q_cardiomyopathy_efficacy-prj ;
    holon:narrativeFunction "Summarises evidence on managing Cardiomyopathy with metoprolol."^^xsd:string ;
    holon:prerequisiteFor oeq:q_cardiomyopathy_safety ;
    holon:recordedOn "2025-12-16"^^xsd:date ;
    holon:summaryConfidence 0.87 ;
    oe:aboutDisease oed:cardiomyopathy ;
    oe:answerText "Before the development of disease-modifying therapies for transthyretin amyloidosis cardiomyopathy (ATTR-CM), N-terminal prohormone of B-type natriuretic peptide (NT-proBNP) and troponin I/T were recognized as independent prognostic biomarkers of mortality. This study evaluated the prognostic value of these biomarkers in a contemporary patient population and the impact of vutrisiran, an RNA interference therapeutic that rapidly knocks down circulating transthyretin, on biomarker levels."^^xsd:string ;
    oe:belongsToSpecialty "Cardiology" ;
    oe:cites oesrc:40722060,
        oesrc:40769675,
        oesrc:40864019,
        oesrc:41311138 ;
    oe:questionText "How effective is metoprolol compared with other agents for Cardiomyopathy?"^^xsd:string .

