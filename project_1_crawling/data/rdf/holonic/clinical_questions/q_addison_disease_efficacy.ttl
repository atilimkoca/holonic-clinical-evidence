oeevt:entry_q_addison_disease_efficacy a holon:EntityEntry ;
    holon:entity oed:addison_disease ;
    holon:entryMode "topic-match" .

oeevt:ev_q_addison_disease_efficacy a holon:EvidenceAssertion ;
