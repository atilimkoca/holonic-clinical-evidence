<https://example.org/openevidence/questions/q_osteoporosis_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is prednisone compared with other agents for Osteoporosis?"^^xsd:string ;
    oe:answerText "Zoledronate prevents fractures in older women when administered every 12 to 18 months, but its effects on bone density and bone turnover persist beyond 5 years. Whether infrequent zoledronate administration would prevent vertebral fractures in early postmenopausal women is unknown."^^xsd:string ;
    oe:belongsToSpecialty "Endocrinology" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_osteoporosis_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_osteoporosis_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_osteoporosis_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_osteoporosis_efficacy-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/prednisone> oe:treats <https://example.org/openevidence/diseases/osteoporosis> .
<https://example.org/openevidence/generated/ev_q_osteoporosis_efficacy_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_osteoporosis_efficacy_0-tt> ;
    holon:confidence "0.87"^^xsd:decimal ;
    holon:evidenceLevel "Level-1B" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/39813642> ;
    holon:inHolon <https://example.org/openevidence/questions/q_osteoporosis_efficacy> ;
    oe:effectiveness "effective" .
<https://example.org/openevidence/generated/ev_q_osteoporosis_efficacy_0-tt> rdf:subject <https://example.org/openevidence/drugs/prednisone> ;
    rdf:predicate oe:treats ;
    rdf:object <https://example.org/openevidence/diseases/osteoporosis> .

