oeq:q_multiple_sclerosis_efficacy a holon:ClinicalQuestionHolon ;
    rdfs:label "How effective is rituximab compared with other agents for Multiple Sclerosis?"@en ;
    prov:generatedAtTime "2026-01-01T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
    holon:aggregateConfidence 0.4 ;
    holon:evidenceQualityThreshold 0.5 ;
    holon:hasBoundaryGraph oeq:q_multiple_sclerosis_efficacy-bnd ;
    holon:hasContextGraph oeq:q_multiple_sclerosis_efficacy-ctx ;
    holon:hasInteriorGraph oeq:q_multiple_sclerosis_efficacy-int ;
    holon:hasProjectionGraph oeq:q_multiple_sclerosis_efficacy-prj ;
    holon:narrativeFunction "Summarises evidence on managing Multiple Sclerosis with rituximab."^^xsd:string ;
    holon:prerequisiteFor oeq:q_multiple_sclerosis_safety ;
    holon:recordedOn "2026-01-01"^^xsd:date ;
    holon:summaryConfidence 0.57 ;
    oe:aboutDisease oed:multiple_sclerosis ;
    oe:answerText "Metformin rejuvenates adult rat oligodendrocyte progenitor cells (OPCs) allowing more efficient differentiation into oligodendrocytes and improved remyelination, and therefore is of interest as a therapeutic in demyelinating diseases such as multiple sclerosis (MS). Here, we test whether metformin has a similar effect in human stem cell derived-OPCs."^^xsd:string ;
    oe:belongsToSpecialty "Neurology" ;
    oe:cites oesrc:40464816,
        oesrc:40472290,
        oesrc:40885740,
        oesrc:41284222 ;
    oe:questionText "How effective is rituximab compared with other agents for Multiple Sclerosis?"^^xsd:string .

