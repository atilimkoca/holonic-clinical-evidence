oeq:q_non_hodgkin_lymphoma_safety a holon:ClinicalQuestionHolon ;
    rdfs:label "What are the main adverse effects and contraindications of treating Non-Hodgkin Lymphoma w"@en ;
    prov:generatedAtTime "2026-03-01T10:00:00+00:00"^^xsd:dateTime ;
