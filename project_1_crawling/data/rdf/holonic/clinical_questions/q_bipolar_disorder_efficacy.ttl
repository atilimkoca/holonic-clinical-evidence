    rdf:subject oedrug:lithium .

oeq:q_bipolar_disorder_efficacy a holon:ClinicalQuestionHolon ;
    rdfs:label "How effective is lithium compared with other agents for Bipolar Disorder?"@en ;
    prov:generatedAtTime "2025-09-01T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
    holon:aggregateConfidence 0.59 ;
    holon:evidenceQualityThreshold 0.5 ;
    holon:hasBoundaryGraph oeq:q_bipolar_disorder_efficacy-bnd ;
    holon:hasContextGraph oeq:q_bipolar_disorder_efficacy-ctx ;
    holon:hasInteriorGraph oeq:q_bipolar_disorder_efficacy-int ;
    holon:hasProjectionGraph oeq:q_bipolar_disorder_efficacy-prj ;
    holon:narrativeFunction "Summarises evidence on managing Bipolar Disorder with lithium."^^xsd:string ;
    holon:prerequisiteFor oeq:q_bipolar_disorder_safety ;
    holon:recordedOn "2025-09-01"^^xsd:date ;
    holon:summaryConfidence 0.97 ;
    oe:aboutDisease oed:bipolar_disorder ;
    oe:answerText "Bipolar disorder (BD), characterized by extreme mood shifts between mania and depression, can manifest in childhood, and pose treatment challenges. Treatment for full-criteria BD I or II in children has been partially described in the literature, but major uncertainties exist regarding non-classic presentations, which were originally designated as bipolar \"not otherwise specified\" (BP-NOS) in DSM-IV and in DSM-5 and ICD-11 as either other specified or unspecified BD (S-USBD)."^^xsd:string ;
    oe:belongsToSpecialty "Psychiatry" ;
    oe:cites oesrc:39101769,
        oesrc:39300746,
        oesrc:39946099,
        oesrc:40844121 ;
    oe:questionText "How effective is lithium compared with other agents for Bipolar Disorder?"^^xsd:string .

