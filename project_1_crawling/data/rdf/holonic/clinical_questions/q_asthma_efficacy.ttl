oeevt:entry_q_asthma_efficacy a holon:EntityEntry ;
    holon:entity oed:asthma ;
    holon:entryMode "topic-match" .

oeevt:ev_q_asthma_efficacy a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev_q_asthma_efficacy-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.93 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q_asthma_efficacy ;
    holon:recordedOn "2026-06-01"^^xsd:date ;
    oe:cites oesrc:41005695 ;
