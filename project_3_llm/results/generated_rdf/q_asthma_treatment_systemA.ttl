<https://example.org/openevidence/questions/q_asthma_treatment> a holon:ClinicalQuestionHolon ;
    oe:questionText "What is the recommended first-line pharmacological treatment for Asthma?"^^xsd:string ;
    oe:answerText "Chronic rhinosinusitis with nasal polyps (CRSwNP) is predominantly driven by type 2 inflammation. The biologics dupilumab and omalizumab, which target drivers and mediators of type 2 inflammation (interleukin [IL]-4/IL-13 signaling and immunoglobulin E [IgE], respectively), are efficacious in treating CRSwNP but direct comparisons are few."^^xsd:string ;
    oe:belongsToSpecialty "Pulmonology" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_asthma_treatment-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_asthma_treatment-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_asthma_treatment-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_asthma_treatment-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/salbutamol> oe:treats <https://example.org/openevidence/diseases/asthma> .
