    holon:recordedOn "2025-06-01"^^xsd:date ;
    holon:summaryConfidence 0.52 ;
    oe:aboutDisease oed:ankylosing_spondylitis ;
    oe:answerText "Axial spondyloarthritis (axSpA) is a complex disease with diverse manifestations, for which new treatment options are warranted. BE MOBILE 1 (non-radiographic (nr)-axSpA) and BE MOBILE 2 (radiographic axSpA (r-axSpA)) are double-blind, phase 3 trials designed to evaluate efficacy and safety of bimekizumab, a novel dual interleukin (IL)-17A and IL-17F inhibitor, across the axSpA spectrum."^^xsd:string ;
    oe:belongsToSpecialty "Rheumatology" ;
    oe:cites oesrc:35185872,
        oesrc:36649967,
        oesrc:37872223,
        oesrc:38566994 ;
    oe:questionText "What are the main adverse effects and contraindications of treating Ankylosing Spondylitis with adalimumab?"^^xsd:string .

