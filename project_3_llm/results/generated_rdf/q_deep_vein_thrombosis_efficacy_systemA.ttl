    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_deep_vein_thrombosis_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_deep_vein_thrombosis_efficacy-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

