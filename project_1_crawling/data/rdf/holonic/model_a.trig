    oeevt:ev_q_rheumatoid_arthritis_safety-tt rdf:object oesym:joint_pain ;
        rdf:predicate oe:causesSideEffect ;
        rdf:subject oedrug:methotrexate .

    oeq:q_rheumatoid_arthritis_safety oe:answerText "To investigate the efficacy, safety, pharmacokinetics, immunogenicity and pharmacodynamics of combination therapy with nipocalimab and certolizumab in participants with active rheumatoid arthritis (RA) despite treatment with advanced therapies. In this phase 2a study, participants were randomised 3:2 to receive combination therapy with nipocalimab (intravenous 30 mg/kg) and certolizumab (subcutaneous 400 mg at weeks 0, 2, 4, then 200 mg) or certolizumab monotherapy every 2 weeks from weeks 0 to 24."^^xsd:string ;
        oe:cites oesrc:41274491,
            oesrc:41376634,
            oesrc:41429683,
            oesrc:41781163 ;
        oe:questionText "What are the main adverse effects and contraindications of treating Rheumatoid Arthritis with methotrexate?"^^xsd:string .

    oedrug:methotrexate oe:causesSideEffect oesym:joint_pain .
}

