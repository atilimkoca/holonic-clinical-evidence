oeq:q_crohn_disease_treatment a holon:ClinicalQuestionHolon ;
    rdfs:label "What is the recommended first-line pharmacological treatment for Crohn Disease?"@en ;
    prov:generatedAtTime "2025-12-19T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
    holon:aggregateConfidence 0.41 ;
    holon:evidenceQualityThreshold 0.5 ;
    holon:hasBoundaryGraph oeq:q_crohn_disease_treatment-bnd ;
    holon:hasContextGraph oeq:q_crohn_disease_treatment-ctx ;
    holon:hasInteriorGraph oeq:q_crohn_disease_treatment-int ;
    holon:hasProjectionGraph oeq:q_crohn_disease_treatment-prj ;
    holon:narrativeFunction "Summarises evidence on managing Crohn Disease with adalimumab."^^xsd:string ;
    holon:prerequisiteFor oeq:q_crohn_disease_efficacy ;
    holon:recordedOn "2025-12-19"^^xsd:date ;
    holon:summaryConfidence 0.89 ;
    oe:aboutDisease oed:crohn_disease ;
    oe:answerText "Despite the availability of biological therapies, suboptimal disease control remains a problem for patients with Crohn's disease. We report the results of the GALAXI-2 and GALAXI-3 studies, which aimed to assess the efficacy and safety of intravenous induction followed by subcutaneous maintenance therapy with guselkumab over 48 weeks in adults with moderately to severely active Crohn's disease."^^xsd:string ;
    oe:belongsToSpecialty "Gastroenterology" ;
    oe:cites oesrc:40001525,
        oesrc:40078047,
        oesrc:40684778,
        oesrc:41419296 ;
    oe:questionText "What is the recommended first-line pharmacological treatment for Crohn Disease?"^^xsd:string .

