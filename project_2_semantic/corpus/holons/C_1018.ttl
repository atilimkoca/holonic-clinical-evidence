@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom1018 a oe:Symptom ;
    rdfs:label "Symptom-1018"@en .

oeevt:entry1018 a holon:EntityEntry ;
    holon:entity oed:disease1018 ;
    holon:entryMode "topic-match" .

oeevt:ev1018_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1018_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.80 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:chain1018 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1018 ;
    oe:effectiveness "effective" .

oeevt:ev1018_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1018_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.89 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:chain1018 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1018 ;
    oe:effectiveness "effective" .

oeevt:ev1018_0-tt rdf:object oed:disease1018 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1018 .

oeevt:ev1018_1-tt rdf:object oed:disease1018 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1018 .

oedrug:drug1018 a oe:Drug ;
    rdfs:label "Drug-1018"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease1018 .

oeq:chain1018 a holon:EvidenceChainHolon ;
    rdfs:label "Holon 1018"@en ;
    holon:aggregateConfidence 0.84 ;
    holon:evidenceQualityThreshold 0.50 ;
    holon:hasBoundaryGraph oeq:chain1018-bnd ;
    holon:hasContextGraph oeq:chain1018-ctx ;
    holon:hasInteriorGraph oeq:chain1018-int ;
    holon:hasProjectionGraph oeq:chain1018-prj ;
    holon:narrativeFunction "Establishes Drug-1018 as first-line for Disease-1018"@en ;
    holon:summaryConfidence 0.85 .

oesrc:src1018 a oe:SystematicReview ;
    rdfs:label "Source-1018"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30001018"^^xsd:string .

oed:disease1018 a oe:Disease ;
    rdfs:label "Disease-1018"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

