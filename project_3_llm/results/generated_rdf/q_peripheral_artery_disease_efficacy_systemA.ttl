<https://example.org/openevidence/questions/q_peripheral_artery_disease_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is clopidogrel compared with other agents for Peripheral Artery Disease?"^^xsd:string ;
    oe:answerText "Testosterone levels in men begin declining in the early years of adulthood, with a 1-2% reduction/year. Low testosterone levels in men are associated with obesity, metabolic syndrome, diabetes mellitus, dyslipidaemia, hypertension and increased cardiovascular mortality."^^xsd:string ;
    oe:belongsToSpecialty "Cardiology" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_peripheral_artery_disease_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_peripheral_artery_disease_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_peripheral_artery_disease_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_peripheral_artery_disease_efficacy-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/clopidogrel> oe:treats <https://example.org/openevidence/diseases/peripheral_artery_disease> .
