    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_trigeminal_neuralgia_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_trigeminal_neuralgia_efficacy-con> ;
    holon:evidenceQualityThreshold "0.40"^^xsd:decimal .

