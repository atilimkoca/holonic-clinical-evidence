oeevt:entry_q_systemic_lupus_erythematosus_efficacy a holon:EntityEntry ;
    holon:entity oed:systemic_lupus_erythematosus ;
    holon:entryMode "topic-match" .

oeevt:ev_q_systemic_lupus_erythematosus_efficacy a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev_q_systemic_lupus_erythematosus_efficacy-tt ;
