<https://example.org/openevidence/questions/q_pancreatitis_treatment> a holon:ClinicalQuestionHolon ;
    oe:questionText "What is the recommended first-line pharmacological treatment for Pancreatitis?"^^xsd:string ;
    oe:answerText "A systematic review and meta-analysis was conducted to synthesize the available data from clinical trials and assess the safety issues of tirzepatide (pancreatitis and gallbladder or biliary disease) in type 2 diabetes (T2D) and obesity. A systematic search was conducted in three electronic databases, namely Embase, PubMed, and the Cochrane Library, up until March 1, 2023, to identify randomized controlled trials (RCTs) comparing tirzepatide to either placebo or active hypoglycemic drugs in individuals with T2D and obesity."^^xsd:string ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_pancreatitis_treatment-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_pancreatitis_treatment-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_pancreatitis_treatment-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_pancreatitis_treatment-con> .

<https://example.org/openevidence/drugs/morphine> oe:treats <https://example.org/openevidence/diseases/pancreatitis> .
<https://example.org/openevidence/generated/ev_q_pancreatitis_treatment_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_pancreatitis_treatment_0-tt> ;
    holon:confidence "0.97"^^xsd:decimal ;
    holon:evidenceLevel "Level-1A" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/37908750> ;
    holon:inHolon <https://example.org/openevidence/questions/q_pancreatitis_treatment> ;
    oe:effectiveness "effective" .
<https://example.org/openevidence/generated/ev_q_pancreatitis_treatment_0-tt> rdf:subject <https://example.org/openevidence/drugs/morphine> ;
    rdf:predicate oe:treats ;
    rdf:object <https://example.org/openevidence/diseases/pancreatitis> .

<https://example.org/openevidence/drugs/apixaban> oe:treats <https://example.org/openevidence/diseases/pulmonary_embolism> .   # ungrounded (naive)
<https://example.org/openevidence/drugs/metoprolol> oe:treats <https://example.org/openevidence/diseases/angina_pectoris> .   # ungrounded (naive)
