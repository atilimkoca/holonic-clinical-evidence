<https://example.org/openevidence/questions/q_gout_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is allopurinol compared with other agents for Gout?"^^xsd:string ;
    oe:answerText "In 2018, the Chinese Society of Endocrinology developed the \"Chinese guideline for diagnosis and treatment of hyperuricemia and gout (2019)\". Over the past 5 years, clinical and experimental research has expanded our knowledge of gout, resulting in novel diagnostic and therapeutic approaches."^^xsd:string ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_gout_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_gout_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_gout_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_gout_efficacy-con> .

<https://example.org/openevidence/drugs/allopurinol> oe:treats <https://example.org/openevidence/diseases/gout> .
<https://example.org/openevidence/generated/ev_q_gout_efficacy_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_gout_efficacy_0-tt> ;
    holon:confidence "0.56"^^xsd:decimal ;
    holon:evidenceLevel "Level-3" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/40692263> ;
    holon:inHolon <https://example.org/openevidence/questions/q_gout_efficacy> ;
    oe:effectiveness "effective" .
<https://example.org/openevidence/generated/ev_q_gout_efficacy_0-tt> rdf:subject <https://example.org/openevidence/drugs/allopurinol> ;
    rdf:predicate oe:treats ;
    rdf:object <https://example.org/openevidence/diseases/gout> .

<https://example.org/openevidence/drugs/levothyroxine> oe:treats <https://example.org/openevidence/diseases/hypothyroidism> .   # ungrounded (naive)
<https://example.org/openevidence/drugs/metoprolol> oe:treats <https://example.org/openevidence/diseases/angina_pectoris> .   # ungrounded (naive)
