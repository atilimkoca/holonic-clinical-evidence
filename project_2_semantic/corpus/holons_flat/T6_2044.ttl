@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom2044 a oe:Symptom ;
    rdfs:label "Symptom-2044"@en .

oeevt:ev2044_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2044_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.93 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:chain2044 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src2044 ;
    oe:effectiveness "effective" .

oeevt:ev2044_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2044_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.88 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:chain2044 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src2044 ;
    oe:effectiveness "effective" .

oeevt:ev2044_0-tt rdf:object oed:disease2044 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2044 .

oeevt:ev2044_1-tt rdf:object oed:disease2044 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2044 .

oedrug:drug2044 a oe:Drug ;
    rdfs:label "Drug-2044"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease2044 .

oeq:chain2044 a holon:EvidenceChainHolon ;
    rdfs:label "Holon 2044"@en ;
    holon:aggregateConfidence 0.20 ;
    holon:narrativeFunction "Establishes Drug-2044 as first-line for Disease-2044"@en ;
    holon:summaryConfidence 0.85 .

oesrc:src2044 a oe:SystematicReview ;
    rdfs:label "Source-2044"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30002044"^^xsd:string .

oed:disease2044 a oe:Disease ;
    rdfs:label "Disease-2044"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

