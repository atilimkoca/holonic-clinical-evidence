oeq:q_post_traumatic_stress_disorder_efficacy a holon:ClinicalQuestionHolon ;
    rdfs:label "How effective is sertraline compared with other agents for Post-Traumatic Stress Disorder?"@en ;
    prov:generatedAtTime "2025-06-01T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
    holon:aggregateConfidence 0.42 ;
    holon:evidenceQualityThreshold 0.5 ;
    holon:hasBoundaryGraph oeq:q_post_traumatic_stress_disorder_efficacy-bnd ;
    holon:hasContextGraph oeq:q_post_traumatic_stress_disorder_efficacy-ctx ;
    holon:hasInteriorGraph oeq:q_post_traumatic_stress_disorder_efficacy-int ;
    holon:hasProjectionGraph oeq:q_post_traumatic_stress_disorder_efficacy-prj ;
    holon:narrativeFunction "Summarises evidence on managing Post-Traumatic Stress Disorder with sertraline."^^xsd:string ;
    holon:prerequisiteFor oeq:q_post_traumatic_stress_disorder_safety ;
    holon:recordedOn "2025-06-01"^^xsd:date ;
    holon:summaryConfidence 0.98 ;
    oe:aboutDisease oed:post_traumatic_stress_disorder ;
    oe:answerText "The current guidelines and canonical norms of diagnosis or treatment for Post-traumatic stress disorder (PTSD) with sleep disorder are still conflicting and have not yet reached a consensus. This study aimed to unravel the most effective countermeasures between two categories (psychotherapy and pharmacotherapy) put forward by the National Institute for Health and Clinical Excellence (NICE) and World Federation of Societies of Biological Psychiatry (WFSBP) respectively to treat PTSD individuals co-exist with sleep disorders."^^xsd:string ;
    oe:belongsToSpecialty "Psychiatry" ;
    oe:cites oesrc:35711024,
        oesrc:36815632,
        oesrc:38795401,
        oesrc:39061119 ;
    oe:questionText "How effective is sertraline compared with other agents for Post-Traumatic Stress Disorder?"^^xsd:string .

