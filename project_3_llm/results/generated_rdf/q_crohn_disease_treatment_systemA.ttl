<https://example.org/openevidence/questions/q_crohn_disease_treatment> a holon:ClinicalQuestionHolon ;
    oe:questionText "What is the recommended first-line pharmacological treatment for Crohn Disease?"^^xsd:string ;
    oe:answerText "Despite the availability of biological therapies, suboptimal disease control remains a problem for patients with Crohn's disease. We report the results of the GALAXI-2 and GALAXI-3 studies, which aimed to assess the efficacy and safety of intravenous induction followed by subcutaneous maintenance therapy with guselkumab over 48 weeks in adults with moderately to severely active Crohn's disease."^^xsd:string ;
    oe:belongsToSpecialty "Gastroenterology" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_crohn_disease_treatment-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_crohn_disease_treatment-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_crohn_disease_treatment-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_crohn_disease_treatment-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/adalimumab> oe:treats <https://example.org/openevidence/diseases/crohn_disease> .
