oeq:q_bipolar_disorder_treatment a holon:ClinicalQuestionHolon ;
    rdfs:label "What is the recommended first-line pharmacological treatment for Bipolar Disorder?"@en ;
    prov:generatedAtTime "2025-11-01T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
