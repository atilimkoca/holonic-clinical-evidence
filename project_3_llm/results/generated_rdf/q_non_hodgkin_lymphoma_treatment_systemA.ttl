    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_non_hodgkin_lymphoma_treatment-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_non_hodgkin_lymphoma_treatment-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

