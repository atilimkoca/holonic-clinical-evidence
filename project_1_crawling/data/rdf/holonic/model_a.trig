    oeevt:ev_q_colorectal_cancer_treatment-tt rdf:object oed:colorectal_cancer ;
        rdf:predicate oe:treats ;
        rdf:subject oedrug:cisplatin .

    oeq:q_colorectal_cancer_treatment oe:answerText "Although peritumoural visceral adipose tissue (tVAT) is anatomically close to tumours such as colorectal cancer, the immune landscape of this tissue and its functional contribution to tumour immunity remain poorly defined. Here, we performed single-cell RNA analysis on the tVAT from patients with colorectal cancer to map its immune landscape and observed that tVAT exhibited a highly immune-infiltrated microenvironment enriched with lymphocytes, especially tumour-specific CD8⁺ T cells."^^xsd:string ;
        oe:cites oesrc:41423446,
            oesrc:41478275,
            oesrc:41486293,
            oesrc:41714703 ;
        oe:questionText "What is the recommended first-line pharmacological treatment for Colorectal Cancer?"^^xsd:string .

    oedrug:cisplatin oe:treats oed:colorectal_cancer .
}

