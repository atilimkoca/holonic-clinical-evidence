        rdf:predicate oe:causesSideEffect ;
        rdf:subject oedrug:imatinib .

    oedrug:imatinib oe:causesSideEffect oesym:fatigue .

    oeq:q_chronic_myeloid_leukemia_safety oe:answerText "The efficacy of and disease control afforded by tyrosine kinase inhibitors (TKIs) in chronic myeloid leukemia in chronic phase (CML-CP) have led to increased longevity and thus the continued pursuit of alternative therapies that are efficacious and maximize tolerability. The 24- and 96-week analyses from ASCEMBL demonstrated superior efficacy, safety, and tolerability of asciminib when compared with bosutinib in later-line therapy, thereby meeting the primary and key secondary objectives."^^xsd:string ;
        oe:cites oesrc:39465372,
            oesrc:39486043,
            oesrc:40102686,
            oesrc:40334072 ;
        oe:questionText "What are the main adverse effects and contraindications of treating Chronic Myeloid Leukemia with imatinib?"^^xsd:string .
}

