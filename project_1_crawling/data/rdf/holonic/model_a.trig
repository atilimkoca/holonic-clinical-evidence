oeq:q_non_hodgkin_lymphoma_safety-int {
    oeevt:ev_q_non_hodgkin_lymphoma_safety a holon:EvidenceAssertion ;
        rdf:reifies oeevt:ev_q_non_hodgkin_lymphoma_safety-tt ;
        holon:assessedBy oeq:openevidence_ai ;
        holon:confidence 0.9 ;
        holon:evidenceLevel "Level-1B" ;
        holon:inHolon oeq:q_non_hodgkin_lymphoma_safety ;
        holon:recordedOn "2026-03-01"^^xsd:date ;
        oe:cites oesrc:41052510 .

    oeevt:ev_q_non_hodgkin_lymphoma_safety-tt rdf:object oesym:fatigue ;
        rdf:predicate oe:causesSideEffect ;
        rdf:subject oedrug:rituximab .

    oeq:q_non_hodgkin_lymphoma_safety oe:answerText "Ibrutinib, a Bruton tyrosine kinase inhibitor, prolongs progression-free survival when added to immunochemotherapy as first line treatment. The ENRICH trial compared the chemotherapy-free combination of ibrutinib and the anti-CD20 antibody rituximab (ibrutinib-rituximab) with standard immunochemotherapy (R-CHOP [rituximab-cyclophosphamide, doxorubicin, vincristine, and prednisolone] or bendamustine-rituximab) in patients 60 years and older with untreated mantle-cell lymphoma."^^xsd:string ;
        oe:cites oesrc:41052510,
            oesrc:41115257,
            oesrc:41380698,
            oesrc:41410728 ;
        oe:questionText "What are the main adverse effects and contraindications of treating Non-Hodgkin Lymphoma with rituximab?"^^xsd:string .

    oedrug:rituximab oe:causesSideEffect oesym:fatigue .
}

