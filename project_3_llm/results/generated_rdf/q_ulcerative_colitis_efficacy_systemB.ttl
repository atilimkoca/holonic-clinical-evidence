<https://example.org/openevidence/questions/q_ulcerative_colitis_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is mesalazine compared with other agents for Ulcerative Colitis?"^^xsd:string ;
    oe:answerText "SOR102 is an oral bispecific antibody comprised of single domain antibodies targeting TNF and interleukin (IL)-23p19. We aimed to assess the safety, pharmacokinetics, clinical, and biological activity of SOR102 in healthy participants and in patients with active ulcerative colitis."^^xsd:string ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_ulcerative_colitis_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_ulcerative_colitis_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_ulcerative_colitis_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_ulcerative_colitis_efficacy-con> .

<https://example.org/openevidence/drugs/mesalazine> oe:treats <https://example.org/openevidence/diseases/ulcerative_colitis> .
<https://example.org/openevidence/generated/ev_q_ulcerative_colitis_efficacy_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_ulcerative_colitis_efficacy_0-tt> ;
