<https://example.org/openevidence/questions/q_community_acquired_pneumonia_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is amoxicillin compared with other agents for Community-Acquired Pneumonia?"^^xsd:string ;
    oe:answerText "Newly released community-acquired pneumonia (CAP) guidelines include a conditional recommendation to treat all hospitalized patients with positive respiratory virus assays with antibacterials. We assessed the frequency, duration, and outcomes of antibacterial prescribing in this population."^^xsd:string ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_community_acquired_pneumonia_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_community_acquired_pneumonia_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_community_acquired_pneumonia_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_community_acquired_pneumonia_efficacy-con> .

<https://example.org/openevidence/drugs/amoxicillin> oe:treats <https://example.org/openevidence/diseases/community_acquired_pneumonia> .
<https://example.org/openevidence/generated/ev_q_community_acquired_pneumonia_efficacy_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_community_acquired_pneumonia_efficacy_0-tt> ;
    holon:confidence "0.53"^^xsd:decimal ;
    holon:evidenceLevel "Level-3" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/41378862> ;
    holon:inHolon <https://example.org/openevidence/questions/q_community_acquired_pneumonia_efficacy> ;
    oe:effectiveness "effective" .
<https://example.org/openevidence/generated/ev_q_community_acquired_pneumonia_efficacy_0-tt> rdf:subject <https://example.org/openevidence/drugs/amoxicillin> ;
    rdf:predicate oe:treats ;
    rdf:object <https://example.org/openevidence/diseases/community_acquired_pneumonia> .

<https://example.org/openevidence/drugs/atorvastatin> oe:treats <https://example.org/openevidence/diseases/coronary_artery_disease> .   # ungrounded (naive)
<https://example.org/openevidence/drugs/levothyroxine> oe:treats <https://example.org/openevidence/diseases/hypothyroidism> .   # ungrounded (naive)
