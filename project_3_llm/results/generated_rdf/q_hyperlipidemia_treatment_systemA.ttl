<https://example.org/openevidence/questions/q_hyperlipidemia_treatment> a holon:ClinicalQuestionHolon ;
    oe:questionText "What is the recommended first-line pharmacological treatment for Hyperlipidemia?"^^xsd:string ;
    oe:answerText "Persons with heterozygous familial hypercholesterolemia (HeFH) are at increased risk of atherosclerotic cardiovascular disease due to lifelong elevated levels of low-density lipoprotein cholesterol (LDL-C). Many patients with HeFH do not achieve guideline-recommended LDL-C goals with the currently available lipid-lowering therapies."^^xsd:string ;
    oe:belongsToSpecialty "Cardiology" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_hyperlipidemia_treatment-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_hyperlipidemia_treatment-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_hyperlipidemia_treatment-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_hyperlipidemia_treatment-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/atorvastatin> oe:treats <https://example.org/openevidence/diseases/hyperlipidemia> .
