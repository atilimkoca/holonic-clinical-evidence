<https://example.org/openevidence/questions/q_breast_cancer_treatment> a holon:ClinicalQuestionHolon ;
    oe:questionText "What is the recommended first-line pharmacological treatment for Breast Cancer?"^^xsd:string ;
    oe:answerText "To report updated results of the phase 3 PHILA trial, which evaluated the efficacy and safety of pyrotinib or placebo in combination with trastuzumab and docetaxel in patients with untreated human epidermal growth factor receptor 2 (HER2) positive metastatic breast cancer. Multicentre, double blind, randomised, placebo controlled phase 3 trial."^^xsd:string ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_breast_cancer_treatment-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_breast_cancer_treatment-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_breast_cancer_treatment-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_breast_cancer_treatment-con> .

<https://example.org/openevidence/drugs/tamoxifen> oe:treats <https://example.org/openevidence/diseases/breast_cancer> .
