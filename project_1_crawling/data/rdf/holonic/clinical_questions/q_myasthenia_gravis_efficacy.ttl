oeq:q_myasthenia_gravis_efficacy a holon:ClinicalQuestionHolon ;
    rdfs:label "How effective is prednisone compared with other agents for Myasthenia Gravis?"@en ;
    prov:generatedAtTime "2025-06-01T10:00:00+00:00"^^xsd:dateTime ;
