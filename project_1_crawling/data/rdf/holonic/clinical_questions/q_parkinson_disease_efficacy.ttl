oeq:q_parkinson_disease_efficacy a holon:ClinicalQuestionHolon ;
    rdfs:label "How effective is levodopa compared with other agents for Parkinson Disease?"@en ;
    prov:generatedAtTime "2026-05-01T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
