    holon:hasInteriorGraph oeq:q_prostate_cancer_efficacy-int ;
    holon:hasProjectionGraph oeq:q_prostate_cancer_efficacy-prj ;
    holon:narrativeFunction "Summarises evidence on managing Prostate Cancer with pembrolizumab."^^xsd:string ;
    holon:prerequisiteFor oeq:q_prostate_cancer_safety ;
    holon:recordedOn "2026-02-28"^^xsd:date ;
    holon:summaryConfidence 0.9 ;
    oe:aboutDisease oed:prostate_cancer ;
    oe:answerText "There is an unmet need for a tool that could predict early favorable prostate-specific antigen (PSA) response in metastatic hormone sensitive prostate cancer (mHSPC) patients receiving androgen receptor pathway inhibitor (ARPI). Here, we train and validate a multivariable logistic regression model to predict early favorable PSA response (≤0.2 ng/mL by 6 months) in these patients."^^xsd:string ;
    oe:belongsToSpecialty "Oncology" ;
    oe:cites oesrc:41086208,
        oesrc:41339923,
        oesrc:41380904,
        oesrc:41402322 ;
    oe:questionText "How effective is pembrolizumab compared with other agents for Prostate Cancer?"^^xsd:string .

