    rdf:reifies <https://example.org/openevidence/generated/ev_q_post_traumatic_stress_disorder_efficacy_0-tt> ;
    holon:confidence "0.98"^^xsd:decimal ;
    holon:evidenceLevel "Level-1A" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/39061119> ;
    holon:inHolon <https://example.org/openevidence/questions/q_post_traumatic_stress_disorder_efficacy> ;
    oe:effectiveness "effective" .
<https://example.org/openevidence/generated/ev_q_post_traumatic_stress_disorder_efficacy_0-tt> rdf:subject <https://example.org/openevidence/drugs/sertraline> ;
    rdf:predicate oe:treats ;
