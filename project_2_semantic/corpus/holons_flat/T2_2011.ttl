@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom2011 a oe:Symptom ;
    rdfs:label "Symptom-2011"@en .

oeevt:ev2011_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2011_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.84 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:q2011 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:ghost2011 ;
    oe:effectiveness "effective" .

oeevt:ev2011_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2011_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.86 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q2011 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src2011 ;
    oe:effectiveness "effective" .

oeevt:ev2011_0-tt rdf:object oed:disease2011 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2011 .

oeevt:ev2011_1-tt rdf:object oed:disease2011 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2011 .

oesrc:src2011 a oe:SystematicReview ;
    rdfs:label "Source-2011"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30002011"^^xsd:string .

oedrug:drug2011 a oe:Drug ;
    rdfs:label "Drug-2011"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease2011 .

oeq:q2011 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 2011"@en ;
    holon:narrativeFunction "Establishes Drug-2011 as first-line for Disease-2011"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-2011 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Endocrinology" ;
    oe:questionText "What is the first-line treatment for Disease-2011?"^^xsd:string .

oed:disease2011 a oe:Disease ;
    rdfs:label "Disease-2011"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

