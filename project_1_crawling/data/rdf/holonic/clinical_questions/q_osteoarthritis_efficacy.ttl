    rdf:subject oedrug:ibuprofen .

oeq:q_osteoarthritis_efficacy a holon:ClinicalQuestionHolon ;
    rdfs:label "How effective is ibuprofen compared with other agents for Osteoarthritis?"@en ;
    prov:generatedAtTime "2025-12-17T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
