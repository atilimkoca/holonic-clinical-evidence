<https://example.org/openevidence/questions/q_myasthenia_gravis_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is prednisone compared with other agents for Myasthenia Gravis?"^^xsd:string ;
    oe:answerText "Generalized myasthenia gravis (gMG) continues to present significant challenges for clinical management due to an unpredictable disease course, frequent disease fluctuations, and varying response to therapy. The recent availability of new pharmacologic therapies presents a valuable opportunity to reevaluate how this disease is classified, assessed, and managed and identify new ways to improve the clinical care of patients with gMG."^^xsd:string ;
    oe:belongsToSpecialty "Neurology" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_myasthenia_gravis_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_myasthenia_gravis_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_myasthenia_gravis_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_myasthenia_gravis_efficacy-con> ;
    holon:evidenceQualityThreshold "0.22"^^xsd:decimal .

<https://example.org/openevidence/drugs/prednisone> oe:treats <https://example.org/openevidence/diseases/myasthenia_gravis> .
