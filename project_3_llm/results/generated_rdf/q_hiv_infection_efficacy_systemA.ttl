<https://example.org/openevidence/questions/q_hiv_infection_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is tenofovir compared with other agents for HIV Infection?"^^xsd:string ;
    oe:answerText "Antiretroviral therapy (ART) interruption typically leads to rapid HIV-1 viral rebound in people with HIV-1. To develop an HIV-1 cure, insight into immunological mechanisms capable of preventing HIV-1 viral rebound is urgently needed."^^xsd:string ;
    oe:belongsToSpecialty "Infectious Disease" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_hiv_infection_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_hiv_infection_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_hiv_infection_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_hiv_infection_efficacy-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/tenofovir> oe:treats <https://example.org/openevidence/diseases/hiv_infection> .
<https://example.org/openevidence/generated/ev_q_hiv_infection_efficacy_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_hiv_infection_efficacy_0-tt> ;
    holon:confidence "0.54"^^xsd:decimal ;
    holon:evidenceLevel "Level-3" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/41776101> ;
    holon:inHolon <https://example.org/openevidence/questions/q_hiv_infection_efficacy> ;
    oe:effectiveness "effective" .
