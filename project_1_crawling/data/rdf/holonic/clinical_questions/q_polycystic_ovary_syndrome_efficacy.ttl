oeq:q_polycystic_ovary_syndrome_efficacy a holon:ClinicalQuestionHolon ;
    rdfs:label "How effective is metformin compared with other agents for Polycystic Ovary Syndrome?"@en ;
    prov:generatedAtTime "2025-07-26T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
    holon:aggregateConfidence 0.49 ;
    holon:evidenceQualityThreshold 0.5 ;
    holon:hasBoundaryGraph oeq:q_polycystic_ovary_syndrome_efficacy-bnd ;
    holon:hasContextGraph oeq:q_polycystic_ovary_syndrome_efficacy-ctx ;
    holon:hasInteriorGraph oeq:q_polycystic_ovary_syndrome_efficacy-int ;
    holon:hasProjectionGraph oeq:q_polycystic_ovary_syndrome_efficacy-prj ;
    holon:narrativeFunction "Summarises evidence on managing Polycystic Ovary Syndrome with metformin."^^xsd:string ;
    holon:prerequisiteFor oeq:q_polycystic_ovary_syndrome_safety ;
    holon:recordedOn "2025-07-26"^^xsd:date ;
    holon:summaryConfidence 0.89 ;
    oe:aboutDisease oed:polycystic_ovary_syndrome ;
    oe:answerText "This study aimed to assess the effects of metformin (MET) monotherapy versus a combination of semaglutide and MET on weight, metabolism, reproductive function, and inflammatory markers in women with polycystic ovary syndrome (PCOS). A total of 100 overweight or obese women with PCOS diagnosed according to the Rotterdam criteria were randomly assigned to two groups: MET (1000 mg twice daily [BID] for 16 weeks) and combination therapy (COM) (1000  mg MET BID plus 1- mg semaglutide once weekly [QW] for 16 weeks)."^^xsd:string ;
    oe:belongsToSpecialty "Endocrinology" ;
    oe:cites oesrc:38725974,
        oesrc:39201722,
        oesrc:39353946,
        oesrc:40713699 ;
    oe:questionText "How effective is metformin compared with other agents for Polycystic Ovary Syndrome?"^^xsd:string .

