oeq:q_breast_cancer_efficacy a holon:ClinicalQuestionHolon ;
    rdfs:label "How effective is tamoxifen compared with other agents for Breast Cancer?"@en ;
    prov:generatedAtTime "2026-05-19T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
