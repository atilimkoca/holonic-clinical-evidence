oeq:q_cirrhosis_safety-int {
    oeevt:ev_q_cirrhosis_safety a holon:EvidenceAssertion ;
        rdf:reifies oeevt:ev_q_cirrhosis_safety-tt ;
        holon:assessedBy oeq:openevidence_ai ;
        holon:confidence 0.88 ;
        holon:evidenceLevel "Level-1B" ;
        holon:inHolon oeq:q_cirrhosis_safety ;
        holon:recordedOn "2026-03-01"^^xsd:date ;
        oe:cites oesrc:41173016 .

    oedrug:furosemide oe:causesSideEffect oesym:edema .

    oeevt:ev_q_cirrhosis_safety-tt rdf:object oesym:edema ;
        rdf:predicate oe:causesSideEffect ;
        rdf:subject oedrug:furosemide .

    oeq:q_cirrhosis_safety oe:answerText "Cholestatic pruritus is common and undertreated in primary biliary cholangitis (PBC) and negatively affects patients' lives. We aimed to evaluate the safety and efficacy of linerixibat, an ileal bile acid transporter inhibitor, as a specific antipruritic therapy in patients with PBC."^^xsd:string ;
        oe:cites oesrc:40756370,
            oesrc:41075517,
            oesrc:41173016,
            oesrc:41369634 ;
        oe:questionText "What are the main adverse effects and contraindications of treating Cirrhosis with furosemide?"^^xsd:string .
}

oeq:q_myasthenia_gravis_treatment-int {
    oeevt:ev_q_myasthenia_gravis_treatment a holon:EvidenceAssertion ;
        rdf:reifies oeevt:ev_q_myasthenia_gravis_treatment-tt ;
        holon:assessedBy oeq:openevidence_ai ;
        holon:confidence 0.88 ;
        holon:evidenceLevel "Level-1B" ;
        holon:inHolon oeq:q_myasthenia_gravis_treatment ;
        holon:recordedOn "2025-06-19"^^xsd:date ;
        oe:cites oesrc:39862879 ;
        oe:effectiveness "effective" .

    oedrug:prednisone oe:treats oed:myasthenia_gravis .

    oeevt:ev_q_myasthenia_gravis_treatment-tt rdf:object oed:myasthenia_gravis ;
        rdf:predicate oe:treats ;
        rdf:subject oedrug:prednisone .

    oeq:q_myasthenia_gravis_treatment oe:answerText "Given burdensome side-effects and long latency for efficacy with conventional agents, there is a continued need for generalised myasthenia gravis treatments that are safe and provide consistently sustained, long-term disease control. Nipocalimab, a neonatal Fc receptor blocker, was associated with dose-dependent reductions in total IgG and anti-acetylcholine receptor (AChR) antibodies and clinically meaningful improvements in the Myasthenia Gravis Activities of Daily Living (MG-ADL) scale in patients with generalised myasthenia gravis in a phase 2 study."^^xsd:string ;
        oe:cites oesrc:37353278,
            oesrc:38321574,
            oesrc:39862879,
            oesrc:40202593 ;
        oe:questionText "What is the recommended first-line pharmacological treatment for Myasthenia Gravis?"^^xsd:string .
}

