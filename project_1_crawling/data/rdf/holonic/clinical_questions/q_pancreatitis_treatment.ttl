oeq:q_pancreatitis_treatment a holon:ClinicalQuestionHolon ;
    rdfs:label "What is the recommended first-line pharmacological treatment for Pancreatitis?"@en ;
    prov:generatedAtTime "2025-06-01T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
    holon:aggregateConfidence 0.66 ;
    holon:evidenceQualityThreshold 0.5 ;
    holon:hasBoundaryGraph oeq:q_pancreatitis_treatment-bnd ;
    holon:hasContextGraph oeq:q_pancreatitis_treatment-ctx ;
    holon:hasInteriorGraph oeq:q_pancreatitis_treatment-int ;
    holon:hasProjectionGraph oeq:q_pancreatitis_treatment-prj ;
    holon:narrativeFunction "Summarises evidence on managing Pancreatitis with morphine."^^xsd:string ;
    holon:prerequisiteFor oeq:q_pancreatitis_efficacy ;
    holon:recordedOn "2025-06-01"^^xsd:date ;
    holon:summaryConfidence 0.97 ;
    oe:aboutDisease oed:pancreatitis ;
    oe:answerText "A systematic review and meta-analysis was conducted to synthesize the available data from clinical trials and assess the safety issues of tirzepatide (pancreatitis and gallbladder or biliary disease) in type 2 diabetes (T2D) and obesity. A systematic search was conducted in three electronic databases, namely Embase, PubMed, and the Cochrane Library, up until March 1, 2023, to identify randomized controlled trials (RCTs) comparing tirzepatide to either placebo or active hypoglycemic drugs in individuals with T2D and obesity."^^xsd:string ;
    oe:belongsToSpecialty "Gastroenterology" ;
    oe:cites oesrc:37908750,
        oesrc:38587247,
        oesrc:39707927,
        oesrc:39961335 ;
    oe:questionText "What is the recommended first-line pharmacological treatment for Pancreatitis?"^^xsd:string .

