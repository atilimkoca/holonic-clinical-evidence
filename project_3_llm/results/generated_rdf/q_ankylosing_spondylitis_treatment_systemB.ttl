<https://example.org/openevidence/questions/q_ankylosing_spondylitis_treatment> a holon:ClinicalQuestionHolon ;
    oe:questionText "What is the recommended first-line pharmacological treatment for Ankylosing Spondylitis?"^^xsd:string ;
    oe:answerText "Modern pharmacological research found that the chemical components of Pubmed, Cochran Library, CNKI, and other databases were searched to collect the randomized controlled trials (RCTs). Then, the risk of bias of RCTs were assessed and data of RCTs were extracted."^^xsd:string ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_ankylosing_spondylitis_treatment-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_ankylosing_spondylitis_treatment-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_ankylosing_spondylitis_treatment-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_ankylosing_spondylitis_treatment-con> .

<https://example.org/openevidence/drugs/adalimumab> oe:treats <https://example.org/openevidence/diseases/ankylosing_spondylitis> .
<https://example.org/openevidence/generated/ev_q_ankylosing_spondylitis_treatment_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_ankylosing_spondylitis_treatment_0-tt> ;
    holon:confidence "0.94"^^xsd:decimal ;
    holon:evidenceLevel "Level-1A" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/35935936> ;
    holon:inHolon <https://example.org/openevidence/questions/q_ankylosing_spondylitis_treatment> ;
    oe:effectiveness "effective" .
<https://example.org/openevidence/generated/ev_q_ankylosing_spondylitis_treatment_0-tt> rdf:subject <https://example.org/openevidence/drugs/adalimumab> ;
    rdf:predicate oe:treats ;
    rdf:object <https://example.org/openevidence/diseases/ankylosing_spondylitis> .

