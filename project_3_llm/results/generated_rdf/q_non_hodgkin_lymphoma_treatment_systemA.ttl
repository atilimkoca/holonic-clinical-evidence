<https://example.org/openevidence/questions/q_non_hodgkin_lymphoma_treatment> a holon:ClinicalQuestionHolon ;
    oe:questionText "What is the recommended first-line pharmacological treatment for Non-Hodgkin Lymphoma?"^^xsd:string ;
    oe:answerText "Follicular lymphoma is characterised by episodes of remission and relapse, with patients requiring multiple lines of therapy. Lenalidomide plus rituximab is a commonly used immunotherapy combination in patients with relapsed or refractory follicular lymphoma."^^xsd:string ;
    oe:belongsToSpecialty "Oncology" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_non_hodgkin_lymphoma_treatment-int> ;
