<https://example.org/openevidence/questions/q_major_depressive_disorder_treatment> a holon:ClinicalQuestionHolon ;
    oe:questionText "What is the recommended first-line pharmacological treatment for Major Depressive Disorder?"^^xsd:string ;
    oe:answerText "There is a need to provide up-to-date, clinically translatable data as it relates to the treatment of a major depressive episode (MDE) with mixed features. PubMed and OVID were searched from inception to July 22, 2024."^^xsd:string ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_major_depressive_disorder_treatment-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_major_depressive_disorder_treatment-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_major_depressive_disorder_treatment-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_major_depressive_disorder_treatment-con> .

<https://example.org/openevidence/drugs/sertraline> oe:treats <https://example.org/openevidence/diseases/major_depressive_disorder> .
<https://example.org/openevidence/generated/ev_q_major_depressive_disorder_treatment_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_major_depressive_disorder_treatment_0-tt> ;
    holon:confidence "0.96"^^xsd:decimal ;
    holon:evidenceLevel "Level-1A" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/40808264> ;
    holon:inHolon <https://example.org/openevidence/questions/q_major_depressive_disorder_treatment> ;
    oe:effectiveness "effective" .
<https://example.org/openevidence/generated/ev_q_major_depressive_disorder_treatment_0-tt> rdf:subject <https://example.org/openevidence/drugs/sertraline> ;
    rdf:predicate oe:treats ;
    rdf:object <https://example.org/openevidence/diseases/major_depressive_disorder> .

<https://example.org/openevidence/drugs/lisinopril> oe:treats <https://example.org/openevidence/diseases/hypertension> .   # ungrounded (naive)
<https://example.org/openevidence/drugs/lithium> oe:treats <https://example.org/openevidence/diseases/bipolar_disorder> .   # ungrounded (naive)
