@prefix oe: <https://example.org/openevidence#> .
@prefix oesym: <https://example.org/openevidence/symptoms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

oesym:abdominal_pain a oe:Symptom ;
    rdfs:label "Abdominal pain"@en .

