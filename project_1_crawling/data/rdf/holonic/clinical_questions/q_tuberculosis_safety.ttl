oeq:q_tuberculosis_safety a holon:ClinicalQuestionHolon ;
    rdfs:label "What are the main adverse effects and contraindications of treating Tuberculosis with ison"@en ;
    prov:generatedAtTime "2026-01-01T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
