@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/openevidence/questions/q_osteoarthritis_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is ibuprofen compared with other agents for Osteoarthritis?"^^xsd:string ;
    oe:answerText "Synovitis has recently been shown to be a critical early stage in development of osteoarthritis (OA), and inhibiting synovitis significantly alleviates OA symptoms. Denosumab, a monoclonal antibody targeting RANKL, previously developed for osteoporosis."^^xsd:string ;
    oe:belongsToSpecialty "Rheumatology" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_osteoarthritis_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_osteoarthritis_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_osteoarthritis_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_osteoarthritis_efficacy-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/ibuprofen> oe:treats <https://example.org/openevidence/diseases/osteoarthritis> .
<https://example.org/openevidence/generated/ev_q_osteoarthritis_efficacy_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_osteoarthritis_efficacy_0-tt> ;
    holon:confidence "0.54"^^xsd:decimal ;
    holon:evidenceLevel "Level-3" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/41407913> ;
    holon:inHolon <https://example.org/openevidence/questions/q_osteoarthritis_efficacy> ;
    oe:effectiveness "effective" .
<https://example.org/openevidence/generated/ev_q_osteoarthritis_efficacy_0-tt> rdf:subject <https://example.org/openevidence/drugs/ibuprofen> ;
    rdf:predicate oe:treats ;
    rdf:object <https://example.org/openevidence/diseases/osteoarthritis> .

