<https://example.org/openevidence/questions/q_ulcerative_colitis_treatment> a holon:ClinicalQuestionHolon ;
    oe:questionText "What is the recommended first-line pharmacological treatment for Ulcerative Colitis?"^^xsd:string ;
    oe:answerText "Etrasimod is an oral, once-daily sphingosine 1-phosphate (S1P) receptor modulator for the treatment of active ulcerative colitis. In the randomised, placebo-controlled, double-blind phase 3 ENLIGHT UC study, also known as the ES101002 study, we aimed to evaluate the efficacy and safety of etrasimod in patients with moderately to severely active ulcerative colitis in East Asia."^^xsd:string ;
    oe:belongsToSpecialty "Gastroenterology" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_ulcerative_colitis_treatment-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_ulcerative_colitis_treatment-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_ulcerative_colitis_treatment-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_ulcerative_colitis_treatment-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/mesalazine> oe:treats <https://example.org/openevidence/diseases/ulcerative_colitis> .
