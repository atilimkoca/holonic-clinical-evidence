@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom1004 a oe:Symptom ;
    rdfs:label "Symptom-1004"@en .

oeevt:ev1004_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1004_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.73 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q1004 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1004 ;
    oe:effectiveness "effective" .

oeevt:ev1004_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1004_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.88 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q1004 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1004 ;
    oe:effectiveness "effective" .

oeevt:ev1004_0-tt rdf:object oed:disease1004 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1004 .

oeevt:ev1004_1-tt rdf:object oed:disease1004 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1004 .

oedrug:drug1004 a oe:Drug ;
    rdfs:label "Drug-1004"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease1004 .

oeq:q1004 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 1004"@en ;
    holon:narrativeFunction "Establishes Drug-1004 as first-line for Disease-1004"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-1004 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Pulmonology" ;
    oe:questionText "What is the first-line treatment for Disease-1004?"^^xsd:string .

oesrc:src1004 a oe:SystematicReview ;
    rdfs:label "Source-1004"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30001004"^^xsd:string .

oed:disease1004 a oe:Disease ;
    rdfs:label "Disease-1004"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

