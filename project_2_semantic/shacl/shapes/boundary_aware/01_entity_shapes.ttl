@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix holon:  <https://example.org/holon#> .
@prefix oe:     <https://example.org/openevidence#> .

# =============================================================================
# SET A — BOUNDARY-AWARE SHACL  ·  FILE 1/4: ENTITY SHAPES
# Structural constraints on the core medical entities and the clinical
# question holon. These are SHARED in spirit with Set B (flat) — they catch
# T1 (structural) and T2 (referential) defects. The boundary-aware ADVANTAGE
# lives in files 03 (boundary meta-shapes) and 04 (cross-layer SPARQL).
# =============================================================================

# --- Clinical Question Holon -------------------------------------------------

oe:ClinicalQuestionShape a sh:NodeShape ;
    sh:targetClass holon:ClinicalQuestionHolon ;
    sh:severity sh:Violation ;

    sh:property [
        sh:path oe:questionText ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minLength 10 ;
        sh:severity sh:Violation ;
        sh:message "Clinical question must have exactly one question text of >= 10 chars (T1)." ;
    ] ;
    sh:property [
        sh:path oe:answerText ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Clinical question must have at least one answer (T1)." ;
    ] ;
    sh:property [
        sh:path oe:belongsToSpecialty ;
        sh:in ( "Cardiology" "Neurology" "Oncology" "Pulmonology" "Endocrinology"
                "Gastroenterology" "Nephrology" "Rheumatology" "Infectious Disease"
                "Psychiatry" "General Medicine" ) ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Clinical question must belong to a recognised specialty (T1)." ;
    ] ;

    # All four holon layers must be present and singular (T1 structural).
    sh:property [ sh:path holon:hasInteriorGraph ;   sh:minCount 1 ; sh:maxCount 1 ;
                  sh:severity sh:Violation ; sh:message "Holon needs exactly one interior graph." ] ;
    sh:property [ sh:path holon:hasBoundaryGraph ;   sh:minCount 1 ; sh:maxCount 1 ;
                  sh:severity sh:Violation ; sh:message "Holon needs exactly one boundary graph." ] ;
    sh:property [ sh:path holon:hasProjectionGraph ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:severity sh:Violation ; sh:message "Holon needs exactly one projection graph." ] ;
    sh:property [ sh:path holon:hasContextGraph ;    sh:minCount 1 ; sh:maxCount 1 ;
                  sh:severity sh:Violation ; sh:message "Holon needs exactly one context graph." ] .

# --- Disease -----------------------------------------------------------------

oe:DiseaseShape a sh:NodeShape ;
    sh:targetClass oe:Disease ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Disease must have a label (T1)." ;
    ] ;
    sh:property [
        sh:path oe:icdCode ;
        sh:datatype xsd:string ;
        sh:pattern "^[A-Z][0-9]{2}(\\.[0-9]{1,4})?$" ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:message "ICD code must look like 'I10' or 'I10.0' (T1)." ;
    ] ;
    # Referential integrity: every symptom referenced must be a typed Symptom (T2).
    sh:property [
        sh:path oe:hasSymptom ;
        sh:class oe:Symptom ;
        sh:severity sh:Violation ;
        sh:message "hasSymptom must point to a declared oe:Symptom (T2 referential)." ;
    ] .

# --- Drug --------------------------------------------------------------------

oe:DrugShape a sh:NodeShape ;
    sh:targetClass oe:Drug ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Drug must have a label (T1)." ;
    ] ;
    sh:property [
        sh:path oe:atcCode ;
        sh:datatype xsd:string ;
        sh:pattern "^[A-Z][0-9]{2}[A-Z]{2}[0-9]{2}$" ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:message "ATC code must look like 'C09AA03' (T1)." ;
    ] ;
    # 'treats' object must be a declared Disease (T2 referential).
    sh:property [
        sh:path oe:treats ;
        sh:class oe:Disease ;
        sh:severity sh:Violation ;
        sh:message "treats must point to a declared oe:Disease (T2 referential)." ;
        # SHACL 1.2 native linkage: validate the RDF 1.2 reification on this triple.
        # (Executed by the runnable equivalent oe:EvidenceReifierShape in file 02.)
        sh:reifierShape oe:EvidenceReifierShape ;
    ] .

# --- Treatment relationship --------------------------------------------------

oe:TreatmentShape a sh:NodeShape ;
    sh:targetClass oe:Treatment ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Treatment should carry a label (T1)." ;
    ] .

# --- Evidence source ---------------------------------------------------------

oe:SourceShape a sh:NodeShape ;
    sh:targetClass oe:EvidenceSource ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Evidence source must have a label (T1)." ;
    ] ;
    # A source must be identifiable by PubMed ID OR DOI (sh:or #1).
    sh:or (
        [ sh:property [ sh:path oe:pubmedId ; sh:minCount 1 ] ]
        [ sh:property [ sh:path oe:doi ;      sh:minCount 1 ] ]
    ) ;
    sh:property [
        sh:path oe:publicationDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Evidence source should have a publication date (T1)." ;
    ] .
