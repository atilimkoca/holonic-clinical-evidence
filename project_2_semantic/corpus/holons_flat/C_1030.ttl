@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom1030 a oe:Symptom ;
    rdfs:label "Symptom-1030"@en .

oeevt:ev1030_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1030_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.94 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:chain1030 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1030 ;
    oe:effectiveness "effective" .

oeevt:ev1030_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1030_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.81 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:chain1030 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1030 ;
    oe:effectiveness "effective" .

oeevt:ev1030_0-tt rdf:object oed:disease1030 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1030 .

oeevt:ev1030_1-tt rdf:object oed:disease1030 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1030 .

oedrug:drug1030 a oe:Drug ;
    rdfs:label "Drug-1030"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease1030 .

oeq:chain1030 a holon:EvidenceChainHolon ;
    rdfs:label "Holon 1030"@en ;
    holon:aggregateConfidence 0.88 ;
    holon:narrativeFunction "Establishes Drug-1030 as first-line for Disease-1030"@en ;
    holon:summaryConfidence 0.85 .

oesrc:src1030 a oe:SystematicReview ;
    rdfs:label "Source-1030"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30001030"^^xsd:string .

oed:disease1030 a oe:Disease ;
    rdfs:label "Disease-1030"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

