oeq:q_prostate_cancer_efficacy a holon:ClinicalQuestionHolon ;
    rdfs:label "How effective is pembrolizumab compared with other agents for Prostate Cancer?"@en ;
    prov:generatedAtTime "2026-02-28T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
    holon:aggregateConfidence 0.64 ;
    holon:evidenceQualityThreshold 0.5 ;
    holon:hasBoundaryGraph oeq:q_prostate_cancer_efficacy-bnd ;
