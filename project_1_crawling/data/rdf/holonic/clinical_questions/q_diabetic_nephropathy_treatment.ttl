oeq:q_diabetic_nephropathy_treatment a holon:ClinicalQuestionHolon ;
    rdfs:label "What is the recommended first-line pharmacological treatment for Diabetic Nephropathy?"@en ;
    prov:generatedAtTime "2026-01-01T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
    holon:aggregateConfidence 0.49 ;
    holon:evidenceQualityThreshold 0.5 ;
    holon:hasBoundaryGraph oeq:q_diabetic_nephropathy_treatment-bnd ;
    holon:hasContextGraph oeq:q_diabetic_nephropathy_treatment-ctx ;
    holon:hasInteriorGraph oeq:q_diabetic_nephropathy_treatment-int ;
    holon:hasProjectionGraph oeq:q_diabetic_nephropathy_treatment-prj ;
    holon:narrativeFunction "Summarises evidence on managing Diabetic Nephropathy with lisinopril."^^xsd:string ;
    holon:prerequisiteFor oeq:q_diabetic_nephropathy_efficacy ;
    holon:recordedOn "2026-01-01"^^xsd:date ;
    holon:summaryConfidence 0.91 ;
    oe:aboutDisease oed:diabetic_nephropathy ;
    oe:answerText "Limited evidence exists to support the simultaneous initiation of sodium-glucose cotransporter-2 inhibitors and finerenone, a nonsteroidal mineralocorticoid receptor antagonist, in persons with chronic kidney disease and type 2 diabetes. We randomly assigned participants with chronic kidney disease (estimated glomerular filtration rate [eGFR], 30 to 90 ml per minute per 1.73 m At baseline, the urinary albumin-to-creatinine ratio was similar among the participants in the three groups; the median value was 579 (interquartile range, 292 to 1092) among those with available data (265 in the combination-therapy group, 258 in the finerenone group, and 261 participants in the empagliflozin group)."^^xsd:string ;
    oe:belongsToSpecialty "Nephrology" ;
    oe:cites oesrc:40327845,
        oesrc:40450519,
        oesrc:40470996,
        oesrc:40935879 ;
    oe:questionText "What is the recommended first-line pharmacological treatment for Diabetic Nephropathy?"^^xsd:string .

