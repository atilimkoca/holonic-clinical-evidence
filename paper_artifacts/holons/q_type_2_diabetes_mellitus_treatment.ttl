oeq:q_type_2_diabetes_mellitus_treatment a holon:ClinicalQuestionHolon ;
    rdfs:label "What is the recommended first-line pharmacological treatment for Type 2 Diabetes Mellitus?"@en ;
    prov:generatedAtTime "2026-04-02T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
