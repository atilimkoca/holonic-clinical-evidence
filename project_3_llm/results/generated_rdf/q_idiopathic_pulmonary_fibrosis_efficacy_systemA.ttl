<https://example.org/openevidence/questions/q_idiopathic_pulmonary_fibrosis_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is prednisone compared with other agents for Idiopathic Pulmonary Fibrosis?"^^xsd:string ;
    oe:answerText "Idiopathic pulmonary fibrosis (IPF) is an aggressive interstitial lung disease with a high mortality rate. Putative drug targets in IPF have failed to translate into effective therapies at the clinical level."^^xsd:string ;
    oe:belongsToSpecialty "Pulmonology" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_idiopathic_pulmonary_fibrosis_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_idiopathic_pulmonary_fibrosis_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_idiopathic_pulmonary_fibrosis_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_idiopathic_pulmonary_fibrosis_efficacy-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/prednisone> oe:treats <https://example.org/openevidence/diseases/idiopathic_pulmonary_fibrosis> .
