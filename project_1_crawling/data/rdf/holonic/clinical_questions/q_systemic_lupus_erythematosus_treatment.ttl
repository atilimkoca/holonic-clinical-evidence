oeq:q_systemic_lupus_erythematosus_treatment a holon:ClinicalQuestionHolon ;
    rdfs:label "What is the recommended first-line pharmacological treatment for Systemic Lupus Erythemato"@en ;
    prov:generatedAtTime "2026-01-01T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
    holon:aggregateConfidence 0.56 ;
    holon:evidenceQualityThreshold 0.5 ;
    holon:hasBoundaryGraph oeq:q_systemic_lupus_erythematosus_treatment-bnd ;
    holon:hasContextGraph oeq:q_systemic_lupus_erythematosus_treatment-ctx ;
    holon:hasInteriorGraph oeq:q_systemic_lupus_erythematosus_treatment-int ;
    holon:hasProjectionGraph oeq:q_systemic_lupus_erythematosus_treatment-prj ;
    holon:narrativeFunction "Summarises evidence on managing Systemic Lupus Erythematosus with prednisone."^^xsd:string ;
    holon:prerequisiteFor oeq:q_systemic_lupus_erythematosus_efficacy ;
    holon:recordedOn "2026-01-01"^^xsd:date ;
    holon:summaryConfidence 0.9 ;
    oe:aboutDisease oed:systemic_lupus_erythematosus ;
    oe:answerText "Telitacicept, a new dual inhibitor of the cytokines B-lymphocyte stimulator (BLyS) and APRIL (a proliferation-inducing ligand), showed efficacy in adults with active systemic lupus erythematosus (SLE) in a phase 2b trial when added to standard therapy. We conducted a phase 3 trial in China in which participants with active SLE were randomly assigned (in a 1:1 ratio) to receive telitacicept (160 mg) or placebo subcutaneously once weekly for 52 weeks, in addition to standard therapy."^^xsd:string ;
    oe:belongsToSpecialty "Rheumatology" ;
    oe:cites oesrc:40676245,
        oesrc:40931063,
        oesrc:41092329,
        oesrc:41107121 ;
    oe:questionText "What is the recommended first-line pharmacological treatment for Systemic Lupus Erythematosus?"^^xsd:string .

