@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom1011 a oe:Symptom ;
    rdfs:label "Symptom-1011"@en .

oeevt:ev1011_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1011_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.76 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:q1011 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1011 ;
    oe:effectiveness "effective" .

oeevt:ev1011_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1011_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.80 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:q1011 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1011 ;
    oe:effectiveness "effective" .

oeevt:ev1011_0-tt rdf:object oed:disease1011 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1011 .

oeevt:ev1011_1-tt rdf:object oed:disease1011 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1011 .

oedrug:drug1011 a oe:Drug ;
    rdfs:label "Drug-1011"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease1011 .

oeq:q1011 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 1011"@en ;
    holon:narrativeFunction "Establishes Drug-1011 as first-line for Disease-1011"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-1011 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Oncology" ;
    oe:questionText "What is the first-line treatment for Disease-1011?"^^xsd:string .

oesrc:src1011 a oe:SystematicReview ;
    rdfs:label "Source-1011"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30001011"^^xsd:string .

oed:disease1011 a oe:Disease ;
    rdfs:label "Disease-1011"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

