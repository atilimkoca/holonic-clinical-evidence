@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom1044 a oe:Symptom ;
    rdfs:label "Symptom-1044"@en .

oeevt:entry1044 a holon:EntityEntry ;
    holon:entity oed:disease1044 ;
    holon:entryMode "topic-match" .

oeevt:ev1044_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1044_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.76 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:q1044 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1044 ;
    oe:effectiveness "effective" .

oeevt:ev1044_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1044_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.81 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q1044 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1044 ;
    oe:effectiveness "effective" .

oeevt:ev1044_0-tt rdf:object oed:disease1044 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1044 .

oeevt:ev1044_1-tt rdf:object oed:disease1044 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1044 .

oedrug:drug1044 a oe:Drug ;
    rdfs:label "Drug-1044"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease1044 .

oeq:q1044 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 1044"@en ;
    holon:evidenceQualityThreshold 0.50 ;
    holon:hasBoundaryGraph oeq:q1044-bnd ;
    holon:hasContextGraph oeq:q1044-ctx ;
    holon:hasInteriorGraph oeq:q1044-int ;
    holon:hasProjectionGraph oeq:q1044-prj ;
    holon:narrativeFunction "Establishes Drug-1044 as first-line for Disease-1044"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-1044 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Psychiatry" ;
    oe:questionText "What is the first-line treatment for Disease-1044?"^^xsd:string .

oesrc:src1044 a oe:SystematicReview ;
    rdfs:label "Source-1044"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30001044"^^xsd:string .

oed:disease1044 a oe:Disease ;
    rdfs:label "Disease-1044"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

