    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/40063960> ;
    holon:inHolon <https://example.org/openevidence/questions/q_gout_treatment> ;
    oe:effectiveness "inconclusive" .
<https://example.org/openevidence/generated/ev_q_gout_treatment_0-tt> rdf:subject <https://example.org/openevidence/drugs/allopurinol> ;
