    holon:hasInteriorGraph oeq:q_influenza_treatment-int ;
    holon:hasProjectionGraph oeq:q_influenza_treatment-prj ;
    holon:narrativeFunction "Summarises evidence on managing Influenza with oseltamivir."^^xsd:string ;
