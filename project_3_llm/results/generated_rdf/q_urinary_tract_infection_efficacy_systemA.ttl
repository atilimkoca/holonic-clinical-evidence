<https://example.org/openevidence/questions/q_urinary_tract_infection_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is ciprofloxacin compared with other agents for Urinary Tract Infection?"^^xsd:string ;
    oe:answerText "Existing antibiotics for uncomplicated urinary tract infections are becoming less reliably effective owing to increasing antimicrobial resistance. Our objective was to evaluate the safety and efficacy of sulopenem/probenecid for uncomplicated urinary tract infections."^^xsd:string ;
    oe:belongsToSpecialty "Infectious Disease" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_urinary_tract_infection_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_urinary_tract_infection_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_urinary_tract_infection_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_urinary_tract_infection_efficacy-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/ciprofloxacin> oe:treats <https://example.org/openevidence/diseases/urinary_tract_infection> .
<https://example.org/openevidence/generated/ev_q_urinary_tract_infection_efficacy_0> a holon:EvidenceAssertion ;
