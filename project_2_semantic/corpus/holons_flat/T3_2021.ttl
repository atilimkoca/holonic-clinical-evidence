@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom2021 a oe:Symptom ;
    rdfs:label "Symptom-2021"@en .

oeevt:ev2021_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2021_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.80 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:q2021 ;
    holon:recordedOn "2015-01-01"^^xsd:date ;
    oe:cites oesrc:src2021 ;
    oe:effectiveness "effective" .

oeevt:ev2021_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2021_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.86 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q2021 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src2021 ;
    oe:effectiveness "effective" .

oeevt:ev2021_0-tt rdf:object oed:disease2021 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2021 .

oeevt:ev2021_1-tt rdf:object oed:disease2021 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2021 .

oedrug:drug2021 a oe:Drug ;
    rdfs:label "Drug-2021"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease2021 .

oeq:q2021 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 2021"@en ;
    holon:narrativeFunction "Establishes Drug-2021 as first-line for Disease-2021"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-2021 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Psychiatry" ;
    oe:questionText "What is the first-line treatment for Disease-2021?"^^xsd:string .

oesrc:src2021 a oe:SystematicReview ;
    rdfs:label "Source-2021"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30002021"^^xsd:string .

oed:disease2021 a oe:Disease ;
    rdfs:label "Disease-2021"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

