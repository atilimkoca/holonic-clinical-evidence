<https://example.org/openevidence/questions/q_coronary_artery_disease_treatment> a holon:ClinicalQuestionHolon ;
    oe:questionText "What is the recommended first-line pharmacological treatment for Coronary Artery Disease?"^^xsd:string ;
    oe:answerText "Aspirin monotherapy is recommended indefinitely for patients with established coronary artery disease (CAD). The aim of this individual patient level meta-analysis was to provide a comprehensive evaluation of the comparative efficacy and safety of clopidogrel versus aspirin monotherapy in patients with established CAD, most of whom had undergone percutaneous coronary intervention or had acute coronary syndrome."^^xsd:string ;
    oe:belongsToSpecialty "Cardiology" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_coronary_artery_disease_treatment-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_coronary_artery_disease_treatment-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_coronary_artery_disease_treatment-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_coronary_artery_disease_treatment-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/atorvastatin> oe:treats <https://example.org/openevidence/diseases/coronary_artery_disease> .
