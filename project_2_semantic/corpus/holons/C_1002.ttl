@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom1002 a oe:Symptom ;
    rdfs:label "Symptom-1002"@en .

oeevt:entry1002 a holon:EntityEntry ;
    holon:entity oed:disease1002 ;
    holon:entryMode "topic-match" .

oeevt:ev1002_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1002_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.85 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q1002 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1002 ;
    oe:effectiveness "effective" .

oeevt:ev1002_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1002_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.92 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q1002 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1002 ;
    oe:effectiveness "effective" .

oeevt:ev1002_0-tt rdf:object oed:disease1002 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1002 .

oeevt:ev1002_1-tt rdf:object oed:disease1002 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1002 .

oedrug:drug1002 a oe:Drug ;
    rdfs:label "Drug-1002"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease1002 .

oeq:q1002 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 1002"@en ;
    holon:evidenceQualityThreshold 0.50 ;
    holon:hasBoundaryGraph oeq:q1002-bnd ;
    holon:hasContextGraph oeq:q1002-ctx ;
    holon:hasInteriorGraph oeq:q1002-int ;
    holon:hasProjectionGraph oeq:q1002-prj ;
    holon:narrativeFunction "Establishes Drug-1002 as first-line for Disease-1002"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-1002 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Endocrinology" ;
    oe:questionText "What is the first-line treatment for Disease-1002?"^^xsd:string .

oesrc:src1002 a oe:SystematicReview ;
    rdfs:label "Source-1002"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30001002"^^xsd:string .

oed:disease1002 a oe:Disease ;
    rdfs:label "Disease-1002"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

