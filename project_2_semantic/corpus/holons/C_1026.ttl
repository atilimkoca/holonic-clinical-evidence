@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom1026 a oe:Symptom ;
    rdfs:label "Symptom-1026"@en .

oeevt:entry1026 a holon:EntityEntry ;
    holon:entity oed:disease1026 ;
    holon:entryMode "topic-match" .

oeevt:ev1026_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1026_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.94 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:q1026 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1026 ;
    oe:effectiveness "effective" .

oeevt:ev1026_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1026_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.77 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q1026 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1026 ;
    oe:effectiveness "effective" .

oeevt:ev1026_0-tt rdf:object oed:disease1026 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1026 .

oeevt:ev1026_1-tt rdf:object oed:disease1026 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1026 .

oedrug:drug1026 a oe:Drug ;
    rdfs:label "Drug-1026"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease1026 .

oeq:q1026 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 1026"@en ;
    holon:evidenceQualityThreshold 0.50 ;
    holon:hasBoundaryGraph oeq:q1026-bnd ;
    holon:hasContextGraph oeq:q1026-ctx ;
    holon:hasInteriorGraph oeq:q1026-int ;
    holon:hasProjectionGraph oeq:q1026-prj ;
    holon:narrativeFunction "Establishes Drug-1026 as first-line for Disease-1026"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-1026 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Cardiology" ;
    oe:questionText "What is the first-line treatment for Disease-1026?"^^xsd:string .

oesrc:src1026 a oe:SystematicReview ;
    rdfs:label "Source-1026"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30001026"^^xsd:string .

oed:disease1026 a oe:Disease ;
    rdfs:label "Disease-1026"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

