oeevt:entry_q_influenza_efficacy a holon:EntityEntry ;
    holon:entity oed:influenza ;
    holon:entryMode "topic-match" .

oeevt:ev_q_influenza_efficacy a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev_q_influenza_efficacy-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.95 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q_influenza_efficacy ;
    holon:recordedOn "2025-06-01"^^xsd:date ;
    oe:cites oesrc:39181595 ;
    oe:effectiveness "effective" .

oedrug:oseltamivir oe:treats oed:influenza .

oeevt:ev_q_influenza_efficacy-tt rdf:object oed:influenza ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:oseltamivir .

oeq:q_influenza_efficacy a holon:ClinicalQuestionHolon ;
    rdfs:label "How effective is oseltamivir compared with other agents for Influenza?"@en ;
    prov:generatedAtTime "2025-06-01T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
    holon:aggregateConfidence 0.76 ;
    holon:evidenceQualityThreshold 0.5 ;
    holon:hasBoundaryGraph oeq:q_influenza_efficacy-bnd ;
    holon:hasContextGraph oeq:q_influenza_efficacy-ctx ;
    holon:hasInteriorGraph oeq:q_influenza_efficacy-int ;
    holon:hasProjectionGraph oeq:q_influenza_efficacy-prj ;
    holon:narrativeFunction "Summarises evidence on managing Influenza with oseltamivir."^^xsd:string ;
    holon:prerequisiteFor oeq:q_influenza_safety ;
    holon:recordedOn "2025-06-01"^^xsd:date ;
    holon:summaryConfidence 0.95 ;
    oe:aboutDisease oed:influenza ;
    oe:answerText "The optimal antiviral drug for treatment of severe influenza remains unclear. To support updated WHO influenza clinical guidelines, this systematic review and network meta-analysis evaluated antivirals for treatment of patients with severe influenza."^^xsd:string ;
    oe:belongsToSpecialty "Infectious Disease" ;
    oe:cites oesrc:38865154,
        oesrc:39181595,
        oesrc:39804622,
        oesrc:40267424 ;
    oe:questionText "How effective is oseltamivir compared with other agents for Influenza?"^^xsd:string .

