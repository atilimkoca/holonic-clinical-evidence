<https://example.org/openevidence/questions/q_trigeminal_neuralgia_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is gabapentin compared with other agents for Trigeminal Neuralgia?"^^xsd:string ;
    oe:answerText "Although trigeminal neuralgia is well known to neurologists, recent developments in classification and clinical diagnosis, new MRI methods, and a debate about surgical options necessitate an update on the topic. Currently, a worldwide controversy exists regarding the classification, diagnostic process, and surgical treatment of trigeminal neuralgia."^^xsd:string ;
    oe:belongsToSpecialty "Neurology" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_trigeminal_neuralgia_efficacy-int> ;
