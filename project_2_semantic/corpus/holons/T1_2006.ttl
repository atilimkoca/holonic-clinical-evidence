@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom2006 a oe:Symptom ;
    rdfs:label "Symptom-2006"@en .

oeevt:entry2006 a holon:EntityEntry ;
    holon:entity oed:disease2006 ;
    holon:entryMode "topic-match" .

oeevt:ev2006_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2006_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q2006 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src2006 ;
    oe:effectiveness "effective" .

oeevt:ev2006_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2006_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.86 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:q2006 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src2006 ;
    oe:effectiveness "effective" .

oeevt:ev2006_0-tt rdf:object oed:disease2006 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2006 .

oeevt:ev2006_1-tt rdf:object oed:disease2006 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2006 .

oedrug:drug2006 a oe:Drug ;
    rdfs:label "Drug-2006"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease2006 .

oeq:q2006 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 2006"@en ;
    holon:evidenceQualityThreshold 0.50 ;
    holon:hasBoundaryGraph oeq:q2006-bnd ;
    holon:hasContextGraph oeq:q2006-ctx ;
    holon:hasInteriorGraph oeq:q2006-int ;
    holon:hasProjectionGraph oeq:q2006-prj ;
    holon:narrativeFunction "Establishes Drug-2006 as first-line for Disease-2006"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-2006 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Endocrinology" ;
    oe:questionText "What is the first-line treatment for Disease-2006?"^^xsd:string .

oesrc:src2006 a oe:SystematicReview ;
    rdfs:label "Source-2006"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30002006"^^xsd:string .

oed:disease2006 a oe:Disease ;
    rdfs:label "Disease-2006"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

