oeq:q_diabetic_nephropathy_efficacy a holon:ClinicalQuestionHolon ;
    rdfs:label "How effective is lisinopril compared with other agents for Diabetic Nephropathy?"@en ;
    prov:generatedAtTime "2026-04-01T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
