@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/openevidence/questions/q_colorectal_cancer_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is cisplatin compared with other agents for Colorectal Cancer?"^^xsd:string ;
    oe:answerText "The contribution of chemotherapy-induced tissue injury to individual susceptibility to metastasis remains largely unexplored. We report that chemotherapy indirectly prevents colorectal cancer (CRC) liver metastases by inducing a lasting systemic \"chemomemory\"."^^xsd:string ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_colorectal_cancer_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_colorectal_cancer_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_colorectal_cancer_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_colorectal_cancer_efficacy-con> .

<https://example.org/openevidence/drugs/cisplatin> oe:treats <https://example.org/openevidence/diseases/colorectal_cancer> .
<https://example.org/openevidence/generated/ev_q_colorectal_cancer_efficacy_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_colorectal_cancer_efficacy_0-tt> ;
    holon:confidence "0.57"^^xsd:decimal ;
    holon:evidenceLevel "Level-3" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/41397968> ;
    holon:inHolon <https://example.org/openevidence/questions/q_colorectal_cancer_efficacy> ;
    oe:effectiveness "effective" .
<https://example.org/openevidence/generated/ev_q_colorectal_cancer_efficacy_0-tt> rdf:subject <https://example.org/openevidence/drugs/cisplatin> ;
    rdf:predicate oe:treats ;
    rdf:object <https://example.org/openevidence/diseases/colorectal_cancer> .

<https://example.org/openevidence/drugs/pembrolizumab> oe:treats <https://example.org/openevidence/diseases/non_small_cell_lung_cancer> .   # ungrounded (naive)
<https://example.org/openevidence/drugs/prednisone> oe:treats <https://example.org/openevidence/diseases/addison_disease> .   # ungrounded (naive)
<https://example.org/openevidence/drugs/tamoxifen> oe:treats <https://example.org/openevidence/diseases/breast_cancer> .   # ungrounded (naive)
