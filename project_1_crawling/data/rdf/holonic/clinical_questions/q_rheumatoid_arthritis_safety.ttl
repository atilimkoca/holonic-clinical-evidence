    holon:recordedOn "2026-03-04"^^xsd:date ;
    holon:summaryConfidence 0.9 ;
    oe:aboutDisease oed:rheumatoid_arthritis ;
    oe:answerText "To investigate the efficacy, safety, pharmacokinetics, immunogenicity and pharmacodynamics of combination therapy with nipocalimab and certolizumab in participants with active rheumatoid arthritis (RA) despite treatment with advanced therapies. In this phase 2a study, participants were randomised 3:2 to receive combination therapy with nipocalimab (intravenous 30 mg/kg) and certolizumab (subcutaneous 400 mg at weeks 0, 2, 4, then 200 mg) or certolizumab monotherapy every 2 weeks from weeks 0 to 24."^^xsd:string ;
    oe:belongsToSpecialty "Rheumatology" ;
