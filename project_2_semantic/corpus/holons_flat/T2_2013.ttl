@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom2013 a oe:Symptom ;
    rdfs:label "Symptom-2013"@en .

oeevt:ev2013_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2013_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.91 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:q2013 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:ghost2013 ;
    oe:effectiveness "effective" .

oeevt:ev2013_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2013_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.91 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:q2013 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src2013 ;
    oe:effectiveness "effective" .

oeevt:ev2013_0-tt rdf:object oed:disease2013 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2013 .

oeevt:ev2013_1-tt rdf:object oed:disease2013 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2013 .

oesrc:src2013 a oe:SystematicReview ;
    rdfs:label "Source-2013"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30002013"^^xsd:string .

oedrug:drug2013 a oe:Drug ;
    rdfs:label "Drug-2013"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease2013 .

oeq:q2013 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 2013"@en ;
    holon:narrativeFunction "Establishes Drug-2013 as first-line for Disease-2013"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-2013 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Pulmonology" ;
    oe:questionText "What is the first-line treatment for Disease-2013?"^^xsd:string .

oed:disease2013 a oe:Disease ;
    rdfs:label "Disease-2013"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

