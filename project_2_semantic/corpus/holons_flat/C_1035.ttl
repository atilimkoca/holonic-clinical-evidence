@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom1035 a oe:Symptom ;
    rdfs:label "Symptom-1035"@en .

oeevt:ev1035_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1035_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.86 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q1035 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1035 ;
    oe:effectiveness "effective" .

oeevt:ev1035_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1035_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.90 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:q1035 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1035 ;
    oe:effectiveness "effective" .

oeevt:ev1035_0-tt rdf:object oed:disease1035 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1035 .

oeevt:ev1035_1-tt rdf:object oed:disease1035 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1035 .

oedrug:drug1035 a oe:Drug ;
    rdfs:label "Drug-1035"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease1035 .

oeq:q1035 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 1035"@en ;
    holon:narrativeFunction "Establishes Drug-1035 as first-line for Disease-1035"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-1035 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Psychiatry" ;
    oe:questionText "What is the first-line treatment for Disease-1035?"^^xsd:string .

oesrc:src1035 a oe:SystematicReview ;
    rdfs:label "Source-1035"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30001035"^^xsd:string .

oed:disease1035 a oe:Disease ;
    rdfs:label "Disease-1035"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

