oedrug:salbutamol oe:treats oed:asthma .

oeevt:ev_q_asthma_efficacy-tt rdf:object oed:asthma ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:salbutamol .

oeq:q_asthma_efficacy a holon:ClinicalQuestionHolon ;
    rdfs:label "How effective is salbutamol compared with other agents for Asthma?"@en ;
    prov:generatedAtTime "2026-06-01T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
    holon:aggregateConfidence 0.66 ;
    holon:evidenceQualityThreshold 0.5 ;
    holon:hasBoundaryGraph oeq:q_asthma_efficacy-bnd ;
    holon:hasContextGraph oeq:q_asthma_efficacy-ctx ;
    holon:hasInteriorGraph oeq:q_asthma_efficacy-int ;
    holon:hasProjectionGraph oeq:q_asthma_efficacy-prj ;
    holon:narrativeFunction "Summarises evidence on managing Asthma with salbutamol."^^xsd:string ;
    holon:prerequisiteFor oeq:q_asthma_safety ;
    holon:recordedOn "2026-06-01"^^xsd:date ;
    holon:summaryConfidence 0.93 ;
    oe:aboutDisease oed:asthma ;
    oe:answerText "Severe asthma affects 5% to 10% of patients with asthma but constitutes close to one-half of the medical costs related to asthma due to higher morbidity and health care utilization. Biologic agents have become a standard of care in those unresponsive to standard treatments yet the choice of biologic agent is complex due to the varying mechanisms of action, efficacies, and lack of head-to-head comparisons."^^xsd:string ;
    oe:belongsToSpecialty "Pulmonology" ;
    oe:cites oesrc:41005695,
        oesrc:41033330,
        oesrc:41354402,
        oesrc:41882474 ;
    oe:questionText "How effective is salbutamol compared with other agents for Asthma?"^^xsd:string .

