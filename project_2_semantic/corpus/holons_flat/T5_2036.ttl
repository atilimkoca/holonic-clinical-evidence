@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom2036 a oe:Symptom ;
    rdfs:label "Symptom-2036"@en .

oeevt:ev2036_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2036_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.85 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:q2036 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src2036 ;
    oe:effectiveness "effective" .

oeevt:ev2036_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2036_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.85 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q2036 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src2036 ;
    oe:effectiveness "effective" .

oeevt:ev2036_partner a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2036_partner-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.82 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q2036_partner ;
    holon:recordedOn "2021-01-01"^^xsd:date ;
    oe:cites oesrc:src2036 ;
    oe:effectiveness "ineffective" .

oeevt:ev2036_0-tt rdf:object oed:disease2036 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2036 .

oeevt:ev2036_1-tt rdf:object oed:disease2036 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2036 .

oeevt:ev2036_partner-tt rdf:object oed:disease2036 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2036 .

oeq:q2036_partner a holon:ClinicalQuestionHolon ;
    holon:narrativeFunction "Contradicts the first holon"@en ;
    holon:summaryConfidence 0.80 ;
    oe:answerText "Evidence suggests no benefit."^^xsd:string ;
    oe:belongsToSpecialty "Cardiology" ;
    oe:questionText "Is Drug-2036 effective for Disease-2036?"^^xsd:string .

oeq:q2036 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 2036"@en ;
    holon:narrativeFunction "Establishes Drug-2036 as first-line for Disease-2036"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-2036 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Cardiology" ;
    oe:questionText "What is the first-line treatment for Disease-2036?"^^xsd:string .

oedrug:drug2036 a oe:Drug ;
    rdfs:label "Drug-2036"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease2036 .

oesrc:src2036 a oe:SystematicReview ;
    rdfs:label "Source-2036"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30002036"^^xsd:string .

oed:disease2036 a oe:Disease ;
    rdfs:label "Disease-2036"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

