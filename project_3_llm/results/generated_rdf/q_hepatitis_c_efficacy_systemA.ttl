<https://example.org/openevidence/questions/q_hepatitis_c_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is tenofovir compared with other agents for Hepatitis C?"^^xsd:string ;
    oe:answerText "The year 2023 marked the 10-year anniversary of the launch of direct-acting antivirals (DAAs) for the treatment of hepatitis C virus (HCV). Monitoring HCV treatment trends by country, region, and globally is important to assess progress toward the World Health Organization's 2030 elimination targets."^^xsd:string ;
    oe:belongsToSpecialty "Infectious Disease" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_hepatitis_c_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_hepatitis_c_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_hepatitis_c_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_hepatitis_c_efficacy-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/tenofovir> oe:treats <https://example.org/openevidence/diseases/hepatitis_c> .
