oeq:q_chronic_myeloid_leukemia_safety a holon:ClinicalQuestionHolon ;
    rdfs:label "What are the main adverse effects and contraindications of treating Chronic Myeloid Leukem"@en ;
    prov:generatedAtTime "2025-08-26T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
    holon:aggregateConfidence 0.56 ;
    holon:evidenceQualityThreshold 0.5 ;
    holon:hasBoundaryGraph oeq:q_chronic_myeloid_leukemia_safety-bnd ;
    holon:hasContextGraph oeq:q_chronic_myeloid_leukemia_safety-ctx ;
    holon:hasInteriorGraph oeq:q_chronic_myeloid_leukemia_safety-int ;
    holon:hasProjectionGraph oeq:q_chronic_myeloid_leukemia_safety-prj ;
    holon:narrativeFunction "Summarises evidence on managing Chronic Myeloid Leukemia with imatinib."^^xsd:string ;
    holon:recordedOn "2025-08-26"^^xsd:date ;
    holon:summaryConfidence 0.88 ;
    oe:aboutDisease oed:chronic_myeloid_leukemia ;
    oe:answerText "The efficacy of and disease control afforded by tyrosine kinase inhibitors (TKIs) in chronic myeloid leukemia in chronic phase (CML-CP) have led to increased longevity and thus the continued pursuit of alternative therapies that are efficacious and maximize tolerability. The 24- and 96-week analyses from ASCEMBL demonstrated superior efficacy, safety, and tolerability of asciminib when compared with bosutinib in later-line therapy, thereby meeting the primary and key secondary objectives."^^xsd:string ;
    oe:belongsToSpecialty "Oncology" ;
    oe:cites oesrc:39465372,
        oesrc:39486043,
        oesrc:40102686,
        oesrc:40334072 ;
    oe:questionText "What are the main adverse effects and contraindications of treating Chronic Myeloid Leukemia with imatinib?"^^xsd:string .

