@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix holon:  <https://example.org/holon#> .
@prefix oe:     <https://example.org/openevidence#> .

# =============================================================================
# SET C — FLAT RDF + CONTEXT-AWARE SPARQL  ·  FILE 1/3: ENTITY + REIFIER SHAPES
#
# Identical copy of Set B file 1/2 — Set C shares the flat field-level base.
#
# This is the baseline against which RQ2 is tested. It enforces the SAME
# field-level structural and referential constraints as Set A, but it has
# NO concept of a holon boundary, layer membership, projection, or
# cross-holon scope. Reifier metadata is validated as a flat node with no
# holon:inHolon link. Consequently it does not execute the T4/T5/T6 checks
# under the baseline access model.
#
# Shapes here are deliberately a strict subset of Set A's field-level shapes,
# so any detection difference is attributable to boundary-awareness alone
# (controlled comparison).
# =============================================================================

# --- Clinical question (same field constraints as Set A) ---------------------

oe:ClinicalQuestionShape a sh:NodeShape ;
    sh:targetClass holon:ClinicalQuestionHolon ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path oe:questionText ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minLength 10 ;
        sh:severity sh:Violation ;
        sh:message "Clinical question must have exactly one question text of >= 10 chars (T1)." ;
    ] ;
    sh:property [
        sh:path oe:answerText ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Clinical question must have at least one answer (T1)." ;
    ] ;
    sh:property [
        sh:path oe:belongsToSpecialty ;
        sh:in ( "Cardiology" "Neurology" "Oncology" "Pulmonology" "Endocrinology"
                "Gastroenterology" "Nephrology" "Rheumatology" "Infectious Disease"
                "Psychiatry" "General Medicine" ) ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Clinical question must belong to a recognised specialty (T1)." ;
    ] .
    # NOTE: the flat model does not require the four holon layers — it has no
    # notion of them. This is an intentional baseline limitation.

# --- Disease (same as Set A) -------------------------------------------------

oe:DiseaseShape a sh:NodeShape ;
    sh:targetClass oe:Disease ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:severity sh:Violation ;
                  sh:message "Disease must have a label (T1)." ] ;
    sh:property [
        sh:path oe:icdCode ;
        sh:datatype xsd:string ;
        sh:pattern "^[A-Z][0-9]{2}(\\.[0-9]{1,4})?$" ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:message "ICD code must look like 'I10' (T1)." ;
    ] ;
    sh:property [
        sh:path oe:hasSymptom ;
        sh:class oe:Symptom ;
        sh:severity sh:Violation ;
        sh:message "hasSymptom must point to a declared oe:Symptom (T2)." ;
    ] .

# --- Drug (same as Set A) ----------------------------------------------------

oe:DrugShape a sh:NodeShape ;
    sh:targetClass oe:Drug ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:severity sh:Violation ;
                  sh:message "Drug must have a label (T1)." ] ;
    sh:property [
        sh:path oe:atcCode ;
        sh:datatype xsd:string ;
        sh:pattern "^[A-Z][0-9]{2}[A-Z]{2}[0-9]{2}$" ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:message "ATC code must look like 'C09AA03' (T1)." ;
    ] ;
    sh:property [
        sh:path oe:treats ;
        sh:class oe:Disease ;
        sh:severity sh:Violation ;
        sh:message "treats must point to a declared oe:Disease (T2)." ;
    ] .

# --- Treatment (same field-level constraint as Set A) -------------------------

oe:TreatmentShape a sh:NodeShape ;
    sh:targetClass oe:Treatment ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:severity sh:Warning ;
                  sh:message "Treatment should carry a label (T1)." ] .

# --- Source (same as Set A, incl. sh:or) -------------------------------------

oe:SourceShape a sh:NodeShape ;
    sh:targetClass oe:EvidenceSource ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:severity sh:Violation ;
                  sh:message "Evidence source must have a label (T1)." ] ;
    sh:or (
        [ sh:property [ sh:path oe:pubmedId ; sh:minCount 1 ] ]
        [ sh:property [ sh:path oe:doi ;      sh:minCount 1 ] ]
    ) ;
    sh:property [
        sh:path oe:publicationDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Evidence source should have a publication date (T1)." ;
    ] .

# --- Flat reifier shape (NO holon:inHolon, NO boundary linkage) --------------
# Validates evidence-assertion metadata as a flat node. Catches T1 (structural
# confidence/level) and T2 (citation must be typed) — exactly like Set A — but
# has no holon membership, so it is blind to T4/T5/T6.

oe:EvidenceAssertionShape a sh:NodeShape ;
    sh:targetClass holon:EvidenceAssertion ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path holon:confidence ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ;
        sh:severity sh:Violation ;
        sh:message "Evidence reification needs exactly one confidence in [0,1] (T1)." ;
    ] ;
    sh:property [
        sh:path holon:evidenceLevel ;
        sh:minCount 1 ;
        sh:in ( "Level-1A" "Level-1B" "Level-2A" "Level-2B" "Level-3" "Level-4" "Level-5" ) ;
        sh:severity sh:Violation ;
        sh:message "Evidence must declare a recognised evidence level (T1)." ;
    ] ;
    sh:property [
        sh:path oe:cites ;
        sh:class oe:EvidenceSource ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Evidence reification must cite a typed source (T2)." ;
    ] .

# --- Generic reifier metadata shape (§2.2 exact name) -------------------------
# Runnable on materialised RDF 1.2 reifier nodes, but intentionally only checks
# local metadata; it does not bind the assertion back to a holon boundary.

oe:ReifierShape a sh:NodeShape ;
    sh:targetSubjectsOf rdf:reifies ;
    sh:severity sh:Warning ;
    sh:property [
        sh:path holon:confidence ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Reifier confidence, if present, must be a single value in [0,1]." ;
    ] .

# --- Provenance shape (§2.2 exact name) ---------------------------------------
# Warning-level so RQ2's Violation-threshold detection counts remain unchanged.

oe:ProvenanceShape a sh:NodeShape ;
    sh:targetClass holon:EvidenceAssertion ;
    sh:severity sh:Warning ;
    sh:property [
        sh:path holon:assessedBy ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Provenance: evidence assertion should identify its assessor." ;
    ] ;
    sh:property [
        sh:path holon:recordedOn ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Provenance: evidence assertion should record an assessment date." ;
    ] .
