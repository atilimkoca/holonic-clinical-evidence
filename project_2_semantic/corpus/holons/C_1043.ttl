@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom1043 a oe:Symptom ;
    rdfs:label "Symptom-1043"@en .

oeevt:entry1043 a holon:EntityEntry ;
    holon:entity oed:disease1043 ;
    holon:entryMode "topic-match" .

oeevt:ev1043_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1043_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.79 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q1043 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1043 ;
    oe:effectiveness "effective" .

oeevt:ev1043_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1043_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.82 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q1043 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1043 ;
    oe:effectiveness "effective" .

oeevt:ev1043_0-tt rdf:object oed:disease1043 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1043 .

oeevt:ev1043_1-tt rdf:object oed:disease1043 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1043 .

oedrug:drug1043 a oe:Drug ;
    rdfs:label "Drug-1043"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease1043 .

oeq:q1043 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 1043"@en ;
    holon:evidenceQualityThreshold 0.50 ;
    holon:hasBoundaryGraph oeq:q1043-bnd ;
    holon:hasContextGraph oeq:q1043-ctx ;
    holon:hasInteriorGraph oeq:q1043-int ;
    holon:hasProjectionGraph oeq:q1043-prj ;
    holon:narrativeFunction "Establishes Drug-1043 as first-line for Disease-1043"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-1043 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Endocrinology" ;
    oe:questionText "What is the first-line treatment for Disease-1043?"^^xsd:string .

oesrc:src1043 a oe:SystematicReview ;
    rdfs:label "Source-1043"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30001043"^^xsd:string .

oed:disease1043 a oe:Disease ;
    rdfs:label "Disease-1043"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

