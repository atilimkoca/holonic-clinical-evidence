@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom1015 a oe:Symptom ;
    rdfs:label "Symptom-1015"@en .

oeevt:entry1015 a holon:EntityEntry ;
    holon:entity oed:disease1015 ;
    holon:entryMode "topic-match" .

oeevt:ev1015_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1015_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.73 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:chain1015 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1015 ;
    oe:effectiveness "effective" .

oeevt:ev1015_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1015_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.78 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:chain1015 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1015 ;
    oe:effectiveness "effective" .

oeevt:ev1015_0-tt rdf:object oed:disease1015 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1015 .

oeevt:ev1015_1-tt rdf:object oed:disease1015 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1015 .

oedrug:drug1015 a oe:Drug ;
    rdfs:label "Drug-1015"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease1015 .

oeq:chain1015 a holon:EvidenceChainHolon ;
    rdfs:label "Holon 1015"@en ;
    holon:aggregateConfidence 0.76 ;
    holon:evidenceQualityThreshold 0.50 ;
    holon:hasBoundaryGraph oeq:chain1015-bnd ;
    holon:hasContextGraph oeq:chain1015-ctx ;
    holon:hasInteriorGraph oeq:chain1015-int ;
    holon:hasProjectionGraph oeq:chain1015-prj ;
    holon:narrativeFunction "Establishes Drug-1015 as first-line for Disease-1015"@en ;
    holon:summaryConfidence 0.85 .

oesrc:src1015 a oe:SystematicReview ;
    rdfs:label "Source-1015"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30001015"^^xsd:string .

oed:disease1015 a oe:Disease ;
    rdfs:label "Disease-1015"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

