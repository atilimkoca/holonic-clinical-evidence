@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom1019 a oe:Symptom ;
    rdfs:label "Symptom-1019"@en .

oeevt:entry1019 a holon:EntityEntry ;
    holon:entity oed:disease1019 ;
    holon:entryMode "topic-match" .

oeevt:ev1019_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1019_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.78 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q1019 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1019 ;
    oe:effectiveness "effective" .

oeevt:ev1019_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1019_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.73 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:q1019 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1019 ;
    oe:effectiveness "effective" .

oeevt:ev1019_0-tt rdf:object oed:disease1019 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1019 .

oeevt:ev1019_1-tt rdf:object oed:disease1019 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1019 .

oedrug:drug1019 a oe:Drug ;
    rdfs:label "Drug-1019"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease1019 .

oeq:q1019 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 1019"@en ;
    holon:evidenceQualityThreshold 0.50 ;
    holon:hasBoundaryGraph oeq:q1019-bnd ;
    holon:hasContextGraph oeq:q1019-ctx ;
    holon:hasInteriorGraph oeq:q1019-int ;
    holon:hasProjectionGraph oeq:q1019-prj ;
    holon:narrativeFunction "Establishes Drug-1019 as first-line for Disease-1019"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-1019 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Cardiology" ;
    oe:questionText "What is the first-line treatment for Disease-1019?"^^xsd:string .

oesrc:src1019 a oe:SystematicReview ;
    rdfs:label "Source-1019"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30001019"^^xsd:string .

oed:disease1019 a oe:Disease ;
