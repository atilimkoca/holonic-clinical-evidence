oeevt:entry_q_chronic_kidney_disease_efficacy a holon:EntityEntry ;
    holon:entity oed:chronic_kidney_disease ;
    holon:entryMode "topic-match" .

oeevt:ev_q_chronic_kidney_disease_efficacy a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev_q_chronic_kidney_disease_efficacy-tt ;
    holon:assessedBy oeq:openevidence_ai ;
