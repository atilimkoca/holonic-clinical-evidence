    rdf:predicate oe:treats ;
    rdf:subject oedrug:prednisone .

oeq:q_systemic_lupus_erythematosus_efficacy a holon:ClinicalQuestionHolon ;
    rdfs:label "How effective is prednisone compared with other agents for Systemic Lupus Erythematosus?"@en ;
    prov:generatedAtTime "2025-12-01T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
    holon:aggregateConfidence 0.42 ;
    holon:evidenceQualityThreshold 0.5 ;
    holon:hasBoundaryGraph oeq:q_systemic_lupus_erythematosus_efficacy-bnd ;
    holon:hasContextGraph oeq:q_systemic_lupus_erythematosus_efficacy-ctx ;
    holon:hasInteriorGraph oeq:q_systemic_lupus_erythematosus_efficacy-int ;
    holon:hasProjectionGraph oeq:q_systemic_lupus_erythematosus_efficacy-prj ;
    holon:narrativeFunction "Summarises evidence on managing Systemic Lupus Erythematosus with prednisone."^^xsd:string ;
    holon:prerequisiteFor oeq:q_systemic_lupus_erythematosus_safety ;
    holon:recordedOn "2025-12-01"^^xsd:date ;
    holon:summaryConfidence 0.93 ;
    oe:aboutDisease oed:systemic_lupus_erythematosus ;
    oe:answerText "This study aimed to use Bayesian network meta-analysis to compare the efficacy and safety of biologics for systemic lupus erythematosus (SLE). A comprehensive and systematic search of electronic databases (PubMed, Medline, Cochrane Library, EMBASE, Web of Science, CNKI, and WanFang Data) was conducted from 2014 to September 2024."^^xsd:string ;
    oe:belongsToSpecialty "Rheumatology" ;
    oe:cites oesrc:40699272,
        oesrc:40788686,
        oesrc:40888883,
        oesrc:41204012 ;
    oe:questionText "How effective is prednisone compared with other agents for Systemic Lupus Erythematosus?"^^xsd:string .

