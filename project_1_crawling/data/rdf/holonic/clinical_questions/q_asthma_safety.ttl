oeq:q_asthma_safety a holon:ClinicalQuestionHolon ;
    rdfs:label "What are the main adverse effects and contraindications of treating Asthma with salbutamol"@en ;
    prov:generatedAtTime "2026-02-01T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oeq:openevidence_ai ;
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/> ;
