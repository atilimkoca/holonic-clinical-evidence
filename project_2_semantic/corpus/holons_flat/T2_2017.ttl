@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom2017 a oe:Symptom ;
    rdfs:label "Symptom-2017"@en .

oeevt:ev2017_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2017_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.81 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q2017 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:ghost2017 ;
    oe:effectiveness "effective" .

oeevt:ev2017_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev2017_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.90 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q2017 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src2017 ;
    oe:effectiveness "effective" .

oeevt:ev2017_0-tt rdf:object oed:disease2017 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2017 .

oeevt:ev2017_1-tt rdf:object oed:disease2017 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug2017 .

oesrc:src2017 a oe:SystematicReview ;
    rdfs:label "Source-2017"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30002017"^^xsd:string .

oedrug:drug2017 a oe:Drug ;
    rdfs:label "Drug-2017"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease2017 .

oeq:q2017 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 2017"@en ;
    holon:narrativeFunction "Establishes Drug-2017 as first-line for Disease-2017"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-2017 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Neurology" ;
    oe:questionText "What is the first-line treatment for Disease-2017?"^^xsd:string .

oed:disease2017 a oe:Disease ;
    rdfs:label "Disease-2017"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

