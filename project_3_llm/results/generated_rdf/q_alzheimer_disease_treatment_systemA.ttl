<https://example.org/openevidence/questions/q_alzheimer_disease_treatment> a holon:ClinicalQuestionHolon ;
    oe:questionText "What is the recommended first-line pharmacological treatment for Alzheimer Disease?"^^xsd:string ;
    oe:answerText "Alzheimer's disease (AD) is traditionally considered irreversible. Here, however, we provide proof of principle for therapeutic reversibility of advanced AD."^^xsd:string ;
    oe:belongsToSpecialty "Neurology" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_alzheimer_disease_treatment-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_alzheimer_disease_treatment-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_alzheimer_disease_treatment-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_alzheimer_disease_treatment-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/donepezil> oe:treats <https://example.org/openevidence/diseases/alzheimer_disease> .
<https://example.org/openevidence/generated/ev_q_alzheimer_disease_treatment_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_alzheimer_disease_treatment_0-tt> ;
    holon:confidence "0.53"^^xsd:decimal ;
    holon:evidenceLevel "Level-3" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/41435831> ;
    holon:inHolon <https://example.org/openevidence/questions/q_alzheimer_disease_treatment> ;
    oe:effectiveness "effective" .
<https://example.org/openevidence/generated/ev_q_alzheimer_disease_treatment_0-tt> rdf:subject <https://example.org/openevidence/drugs/donepezil> ;
