@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom1013 a oe:Symptom ;
    rdfs:label "Symptom-1013"@en .

oeevt:ev1013_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1013_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.89 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q1013 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1013 ;
    oe:effectiveness "effective" .

oeevt:ev1013_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1013_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.87 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q1013 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1013 ;
    oe:effectiveness "effective" .

oeevt:ev1013_0-tt rdf:object oed:disease1013 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1013 .

oeevt:ev1013_1-tt rdf:object oed:disease1013 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1013 .

oedrug:drug1013 a oe:Drug ;
    rdfs:label "Drug-1013"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease1013 .

oeq:q1013 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 1013"@en ;
    holon:narrativeFunction "Establishes Drug-1013 as first-line for Disease-1013"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-1013 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Pulmonology" ;
    oe:questionText "What is the first-line treatment for Disease-1013?"^^xsd:string .

oesrc:src1013 a oe:SystematicReview ;
    rdfs:label "Source-1013"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30001013"^^xsd:string .

oed:disease1013 a oe:Disease ;
    rdfs:label "Disease-1013"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

