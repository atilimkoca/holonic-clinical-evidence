    holon:hasInteriorGraph oeq:q_asthma_safety-int ;
    holon:hasProjectionGraph oeq:q_asthma_safety-prj ;
    holon:narrativeFunction "Summarises evidence on managing Asthma with salbutamol."^^xsd:string ;
    holon:recordedOn "2026-02-01"^^xsd:date ;
    holon:summaryConfidence 0.91 ;
    oe:aboutDisease oed:asthma ;
    oe:answerText "Depemokimab, the first ultra-long-acting respiratory biologic, is under investigation for diseases with underlying type 2 (T2) inflammation. Subcutaneous depemokimab 100 mg was efficacious in patients with T2 asthma characterized by blood eosinophil count and in chronic rhinosinusitis with nasal polyps (CRSwNP) when administered twice-yearly in four Phase III randomized, double-blind, placebo-controlled studies (SWIFT-1/-2 and ANCHOR-1/-2, respectively)."^^xsd:string ;
    oe:belongsToSpecialty "Pulmonology" ;
    oe:cites oesrc:41060060,
        oesrc:41106877,
        oesrc:41160665,
        oesrc:41461999 ;
    oe:questionText "What are the main adverse effects and contraindications of treating Asthma with salbutamol?"^^xsd:string .

