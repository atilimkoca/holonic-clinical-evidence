<https://example.org/openevidence/questions/q_sepsis_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is ceftriaxone compared with other agents for Sepsis?"^^xsd:string ;
    oe:answerText "Interventions to induce lasting human immunodeficiency virus (HIV) remission are needed to obviate the requirement for lifelong antiretroviral therapy. Durable post-intervention control (PIC) of viraemia has been achieved in a subset of people following administration of broadly neutralizing anti-HIV-1 antibodies (bNAb) and analytical interruption of treatment."^^xsd:string ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_sepsis_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_sepsis_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_sepsis_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_sepsis_efficacy-con> .

<https://example.org/openevidence/drugs/ceftriaxone> oe:treats <https://example.org/openevidence/diseases/sepsis> .
<https://example.org/openevidence/generated/ev_q_sepsis_efficacy_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_sepsis_efficacy_0-tt> ;
    holon:confidence "0.52"^^xsd:decimal ;
    holon:evidenceLevel "Level-3" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/41326735> ;
    holon:inHolon <https://example.org/openevidence/questions/q_sepsis_efficacy> ;
    oe:effectiveness "effective" .
<https://example.org/openevidence/generated/ev_q_sepsis_efficacy_0-tt> rdf:subject <https://example.org/openevidence/drugs/ceftriaxone> ;
    rdf:predicate oe:treats ;
    rdf:object <https://example.org/openevidence/diseases/sepsis> .

<https://example.org/openevidence/drugs/atorvastatin> oe:treats <https://example.org/openevidence/diseases/coronary_artery_disease> .   # ungrounded (naive)
<https://example.org/openevidence/drugs/levothyroxine> oe:treats <https://example.org/openevidence/diseases/hypothyroidism> .   # ungrounded (naive)
