@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom1039 a oe:Symptom ;
    rdfs:label "Symptom-1039"@en .

oeevt:entry1039 a holon:EntityEntry ;
    holon:entity oed:disease1039 ;
    holon:entryMode "topic-match" .

oeevt:ev1039_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1039_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.87 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:chain1039 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1039 ;
    oe:effectiveness "effective" .

oeevt:ev1039_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1039_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.75 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:chain1039 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1039 ;
    oe:effectiveness "effective" .

oeevt:ev1039_0-tt rdf:object oed:disease1039 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1039 .

oeevt:ev1039_1-tt rdf:object oed:disease1039 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1039 .

oedrug:drug1039 a oe:Drug ;
    rdfs:label "Drug-1039"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease1039 .

oeq:chain1039 a holon:EvidenceChainHolon ;
    rdfs:label "Holon 1039"@en ;
    holon:aggregateConfidence 0.81 ;
    holon:evidenceQualityThreshold 0.50 ;
    holon:hasBoundaryGraph oeq:chain1039-bnd ;
    holon:hasContextGraph oeq:chain1039-ctx ;
    holon:hasInteriorGraph oeq:chain1039-int ;
    holon:hasProjectionGraph oeq:chain1039-prj ;
    holon:narrativeFunction "Establishes Drug-1039 as first-line for Disease-1039"@en ;
    holon:summaryConfidence 0.85 .

oesrc:src1039 a oe:SystematicReview ;
    rdfs:label "Source-1039"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30001039"^^xsd:string .

oed:disease1039 a oe:Disease ;
    rdfs:label "Disease-1039"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

