<https://example.org/openevidence/questions/q_chronic_kidney_disease_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is lisinopril compared with other agents for Chronic Kidney Disease?"^^xsd:string ;
    oe:answerText "There is uncertainty about the effects of sodium-glucose cotransporter 2 (SGLT2) inhibitors in participants with chronic kidney disease, with guidelines offering different strengths of recommendation based on diabetes status and urine albumin to creatinine ratio (UACR). To assess the relative and absolute effects of SGLT2 inhibitor use across efficacy and serious safety outcomes in participants stratified by diabetes status and UACR (≥200 mg/g or <200 mg/g)."^^xsd:string ;
    oe:belongsToSpecialty "Nephrology" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_chronic_kidney_disease_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_chronic_kidney_disease_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_chronic_kidney_disease_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_chronic_kidney_disease_efficacy-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/lisinopril> oe:treats <https://example.org/openevidence/diseases/chronic_kidney_disease> .
<https://example.org/openevidence/generated/ev_q_chronic_kidney_disease_efficacy_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_chronic_kidney_disease_efficacy_0-tt> ;
    holon:confidence "0.98"^^xsd:decimal ;
    holon:evidenceLevel "Level-1A" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/41202026> ;
    holon:inHolon <https://example.org/openevidence/questions/q_chronic_kidney_disease_efficacy> ;
    oe:effectiveness "effective" .
<https://example.org/openevidence/generated/ev_q_chronic_kidney_disease_efficacy_0-tt> rdf:subject <https://example.org/openevidence/drugs/lisinopril> ;
    rdf:predicate oe:treats ;
    rdf:object <https://example.org/openevidence/diseases/chronic_kidney_disease> .

