<https://example.org/openevidence/questions/q_hiv_infection_treatment> a holon:ClinicalQuestionHolon ;
    oe:questionText "What is the recommended first-line pharmacological treatment for HIV Infection?"^^xsd:string ;
    oe:answerText "Antiretroviral therapy (ART) suppresses HIV but does not eliminate the latent viral reservoir, which persists in programmed cell death protein 1 (PD-1)-expressing CD4."^^xsd:string ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_hiv_infection_treatment-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_hiv_infection_treatment-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_hiv_infection_treatment-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_hiv_infection_treatment-con> .

<https://example.org/openevidence/drugs/tenofovir> oe:treats <https://example.org/openevidence/diseases/hiv_infection> .
<https://example.org/openevidence/generated/ev_q_hiv_infection_treatment_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_hiv_infection_treatment_0-tt> ;
    holon:confidence "0.52"^^xsd:decimal ;
    holon:evidenceLevel "Level-3" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/41680482> ;
    holon:inHolon <https://example.org/openevidence/questions/q_hiv_infection_treatment> ;
    oe:effectiveness "effective" .
<https://example.org/openevidence/generated/ev_q_hiv_infection_treatment_0-tt> rdf:subject <https://example.org/openevidence/drugs/tenofovir> ;
    rdf:predicate oe:treats ;
    rdf:object <https://example.org/openevidence/diseases/hiv_infection> .

