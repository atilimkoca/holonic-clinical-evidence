<https://example.org/openevidence/questions/q_tuberculosis_treatment> a holon:ClinicalQuestionHolon ;
    oe:questionText "What is the recommended first-line pharmacological treatment for Tuberculosis?"^^xsd:string ;
    oe:answerText "Tuberculous meningitis is often lethal, and many survivors have disabilities despite antimicrobial treatment and adjunctive glucocorticoid therapy. Standard-dose rifampin has limited central nervous system penetration."^^xsd:string ;
    oe:belongsToSpecialty "Infectious Disease" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_tuberculosis_treatment-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_tuberculosis_treatment-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_tuberculosis_treatment-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_tuberculosis_treatment-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/isoniazid> oe:treats <https://example.org/openevidence/diseases/tuberculosis> .
