@prefix holon: <https://example.org/holon#> .
@prefix oe: <https://example.org/openevidence#> .
@prefix oed: <https://example.org/openevidence/diseases/> .
@prefix oedrug: <https://example.org/openevidence/drugs/> .
@prefix oeevt: <https://example.org/openevidence/events/> .
@prefix oeq: <https://example.org/openevidence/questions/> .
@prefix oesrc: <https://example.org/openevidence/sources/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oe:symptom1023 a oe:Symptom ;
    rdfs:label "Symptom-1023"@en .

oeevt:entry1023 a holon:EntityEntry ;
    holon:entity oed:disease1023 ;
    holon:entryMode "topic-match" .

oeevt:ev1023_0 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1023_0-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.88 ;
    holon:evidenceLevel "Level-1A" ;
    holon:inHolon oeq:q1023 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1023 ;
    oe:effectiveness "effective" .

oeevt:ev1023_1 a holon:EvidenceAssertion ;
    rdf:reifies oeevt:ev1023_1-tt ;
    holon:assessedBy oeq:openevidence_ai ;
    holon:confidence 0.82 ;
    holon:evidenceLevel "Level-1B" ;
    holon:inHolon oeq:q1023 ;
    holon:recordedOn "2020-06-01"^^xsd:date ;
    oe:cites oesrc:src1023 ;
    oe:effectiveness "effective" .

oeevt:ev1023_0-tt rdf:object oed:disease1023 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1023 .

oeevt:ev1023_1-tt rdf:object oed:disease1023 ;
    rdf:predicate oe:treats ;
    rdf:subject oedrug:drug1023 .

oedrug:drug1023 a oe:Drug ;
    rdfs:label "Drug-1023"@en ;
    oe:approvalDate "2010-01-01"^^xsd:date ;
    oe:atcCode "C09AA03"^^xsd:string ;
    oe:treats oed:disease1023 .

oeq:q1023 a holon:ClinicalQuestionHolon ;
    rdfs:label "Holon 1023"@en ;
    holon:evidenceQualityThreshold 0.50 ;
    holon:hasBoundaryGraph oeq:q1023-bnd ;
    holon:hasContextGraph oeq:q1023-ctx ;
    holon:hasInteriorGraph oeq:q1023-int ;
    holon:hasProjectionGraph oeq:q1023-prj ;
    holon:narrativeFunction "Establishes Drug-1023 as first-line for Disease-1023"@en ;
    holon:summaryConfidence 0.85 ;
    oe:answerText "Drug-1023 is recommended as first-line therapy."^^xsd:string ;
    oe:belongsToSpecialty "Pulmonology" ;
    oe:questionText "What is the first-line treatment for Disease-1023?"^^xsd:string .

oesrc:src1023 a oe:SystematicReview ;
    rdfs:label "Source-1023"@en ;
    oe:publicationDate "2018-01-01"^^xsd:date ;
    oe:pubmedId "30001023"^^xsd:string .

oed:disease1023 a oe:Disease ;
    rdfs:label "Disease-1023"@en ;
    oe:firstDescribedDate "1990-01-01"^^xsd:date ;
    oe:icdCode "I10"^^xsd:string .

