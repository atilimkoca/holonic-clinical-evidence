    holon:aggregateConfidence 0.51 ;
    holon:evidenceQualityThreshold 0.5 ;
    holon:hasBoundaryGraph oeq:q_tuberculosis_safety-bnd ;
    holon:hasContextGraph oeq:q_tuberculosis_safety-ctx ;
    holon:hasInteriorGraph oeq:q_tuberculosis_safety-int ;
    holon:hasProjectionGraph oeq:q_tuberculosis_safety-prj ;
    holon:narrativeFunction "Summarises evidence on managing Tuberculosis with isoniazid."^^xsd:string ;
    holon:recordedOn "2026-01-01"^^xsd:date ;
    holon:summaryConfidence 0.68 ;
    oe:aboutDisease oed:tuberculosis ;
    oe:answerText "People who smoke are at increased risk of unfavourable tuberculosis treatment outcomes compared with those who do not, but the pathways that explain this disparity are unclear. To estimate the difference in a successful end-of-treatment outcome by smoking status among people with multidrug- or rifampicin-resistant tuberculosis (MDR/RR-TB) and to examine if this difference changes if people who smoked had the same retention in treatment as those who did not smoke."^^xsd:string ;
    oe:belongsToSpecialty "Infectious Disease" ;
    oe:cites oesrc:41207943,
        oesrc:41219178,
        oesrc:41448789,
        oesrc:41712806 ;
    oe:questionText "What are the main adverse effects and contraindications of treating Tuberculosis with isoniazid?"^^xsd:string .

