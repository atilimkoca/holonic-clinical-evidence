<https://example.org/openevidence/questions/q_systemic_lupus_erythematosus_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is prednisone compared with other agents for Systemic Lupus Erythematosus?"^^xsd:string ;
    oe:answerText "This study aimed to use Bayesian network meta-analysis to compare the efficacy and safety of biologics for systemic lupus erythematosus (SLE). A comprehensive and systematic search of electronic databases (PubMed, Medline, Cochrane Library, EMBASE, Web of Science, CNKI, and WanFang Data) was conducted from 2014 to September 2024."^^xsd:string ;
    oe:belongsToSpecialty "Rheumatology" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_systemic_lupus_erythematosus_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_systemic_lupus_erythematosus_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_systemic_lupus_erythematosus_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_systemic_lupus_erythematosus_efficacy-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/prednisone> oe:treats <https://example.org/openevidence/diseases/systemic_lupus_erythematosus> .
<https://example.org/openevidence/generated/ev_q_systemic_lupus_erythematosus_efficacy_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_systemic_lupus_erythematosus_efficacy_0-tt> ;
    holon:confidence "0.93"^^xsd:decimal ;
    holon:evidenceLevel "Level-1A" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/40699272> ;
    holon:inHolon <https://example.org/openevidence/questions/q_systemic_lupus_erythematosus_efficacy> ;
    oe:effectiveness "effective" .
<https://example.org/openevidence/generated/ev_q_systemic_lupus_erythematosus_efficacy_0-tt> rdf:subject <https://example.org/openevidence/drugs/prednisone> ;
    rdf:predicate oe:treats ;
    rdf:object <https://example.org/openevidence/diseases/systemic_lupus_erythematosus> .

