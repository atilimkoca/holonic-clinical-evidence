<https://example.org/openevidence/questions/q_multiple_sclerosis_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is rituximab compared with other agents for Multiple Sclerosis?"^^xsd:string ;
    oe:answerText "Metformin rejuvenates adult rat oligodendrocyte progenitor cells (OPCs) allowing more efficient differentiation into oligodendrocytes and improved remyelination, and therefore is of interest as a therapeutic in demyelinating diseases such as multiple sclerosis (MS). Here, we test whether metformin has a similar effect in human stem cell derived-OPCs."^^xsd:string ;
    oe:belongsToSpecialty "Neurology" ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_multiple_sclerosis_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_multiple_sclerosis_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_multiple_sclerosis_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_multiple_sclerosis_efficacy-con> ;
    holon:evidenceQualityThreshold "0.50"^^xsd:decimal .

<https://example.org/openevidence/drugs/rituximab> oe:treats <https://example.org/openevidence/diseases/multiple_sclerosis> .
<https://example.org/openevidence/generated/ev_q_multiple_sclerosis_efficacy_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_multiple_sclerosis_efficacy_0-tt> ;
    holon:confidence "0.57"^^xsd:decimal ;
    holon:evidenceLevel "Level-3" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/40885740> ;
    holon:inHolon <https://example.org/openevidence/questions/q_multiple_sclerosis_efficacy> ;
    oe:effectiveness "effective" .
<https://example.org/openevidence/generated/ev_q_multiple_sclerosis_efficacy_0-tt> rdf:subject <https://example.org/openevidence/drugs/rituximab> ;
    rdf:predicate oe:treats ;
    rdf:object <https://example.org/openevidence/diseases/multiple_sclerosis> .

