<https://example.org/openevidence/questions/q_parkinson_disease_efficacy> a holon:ClinicalQuestionHolon ;
    oe:questionText "How effective is levodopa compared with other agents for Parkinson Disease?"^^xsd:string ;
    oe:answerText "Microglial activation-induced neuroinflammation and impaired neuronal mitophagy are recognized as pivotal pathogeneses in Parkinson's disease (PD). However, the role of microglial mitophagy in microglial activation during PD development remains unclear, and therapeutic interventions targeting this interaction are lacking."^^xsd:string ;
    holon:hasInteriorGraph <https://example.org/openevidence/questions/q_parkinson_disease_efficacy-int> ;
    holon:hasBoundaryGraph <https://example.org/openevidence/questions/q_parkinson_disease_efficacy-bou> ;
    holon:hasProjectionGraph <https://example.org/openevidence/questions/q_parkinson_disease_efficacy-pro> ;
    holon:hasContextGraph <https://example.org/openevidence/questions/q_parkinson_disease_efficacy-con> .

<https://example.org/openevidence/drugs/levodopa> oe:treats <https://example.org/openevidence/diseases/parkinson_disease> .
<https://example.org/openevidence/generated/ev_q_parkinson_disease_efficacy_0> a holon:EvidenceAssertion ;
    rdf:reifies <https://example.org/openevidence/generated/ev_q_parkinson_disease_efficacy_0-tt> ;
    holon:confidence "0.57"^^xsd:decimal ;
    holon:evidenceLevel "Level-3" ;
    holon:assessedBy <https://example.org/openevidence/questions/openevidence_ai> ;
    holon:recordedOn "2026-12-31"^^xsd:date ;
    oe:cites <https://example.org/openevidence/sources/40913726> ;
    holon:inHolon <https://example.org/openevidence/questions/q_parkinson_disease_efficacy> ;
    oe:effectiveness "effective" .
<https://example.org/openevidence/generated/ev_q_parkinson_disease_efficacy_0-tt> rdf:subject <https://example.org/openevidence/drugs/levodopa> ;
    rdf:predicate oe:treats ;
    rdf:object <https://example.org/openevidence/diseases/parkinson_disease> .

<https://example.org/openevidence/drugs/atorvastatin> oe:treats <https://example.org/openevidence/diseases/coronary_artery_disease> .   # ungrounded (naive)
